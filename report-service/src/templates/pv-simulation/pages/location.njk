<div class="page content-page">
  <div class="location-page-bg">
    <div class="section-header">
      <span class="section-number">01</span>
      <h2 class="section-title">{{ data.section_titles.location or "LOCALISATION DE L'INSTALLATION" }}</h2>
    </div>

    {% if data.location_image %}
      <div class="location-image-container">
        <img src="{{ data.location_image }}" alt="Localisation" class="location-image">
      </div>
    {% endif %}

    <div class="location-cards-row">
      {% if data.installation_address %}
        <div class="card">
          <div class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="#4A9B5D" stroke="#FFFFFF" stroke-width="1.5">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3" fill="#FFFFFF"/>
            </svg>
          </div>
          <div class="card-text">
            <div class="card-value" style="font-size: 11pt;">{{ data.installation_address | replace("\n", "<br/>") | safe }}</div>
            <div class="card-label">Adresse d'installation</div>
          </div>
        </div>
      {% endif %}

      {% if data.roof_surface_m2 %}
        <div class="card">
          <div class="card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#4A9B5D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="12" y1="3" x2="12" y2="21"/>
            </svg>
          </div>
          <div class="card-text">
            <div class="card-value">{{ data.roof_surface_m2 | formatInt }}</div>
            <div class="card-unit">m²</div>
            <div class="card-label">Surface de toiture</div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
