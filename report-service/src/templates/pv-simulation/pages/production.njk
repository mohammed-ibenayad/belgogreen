<div class="page content-page production-page">
  <div class="section">
    <div class="section-header">
      <span class="section-number">02</span>
      <h2 class="section-title">{{ data.section_titles.production or 'PRODUCTION ESTIMÉE' }}</h2>
    </div>

    {% if data.chart_monthly_production %}
      <div class="chart-container">
        <img src="{{ data.chart_monthly_production }}" alt="Production mensuelle" class="chart-img">
      </div>
    {% endif %}

    <p class="chart-source">
      Production annuelle : {{ data.annual_production_kwh | formatInt }} kWh/an
      — Source : {{ data.production_source or 'PVGIS (EU Science Hub)' }}
    </p>

    <div class="production-system-bg">
      <h3 class="section-subtitle">{{ data.section_titles.system or 'CARACTÉRISTIQUES DU SYSTÈME' }}</h3>

      <div class="system-container">
        <div class="system-cards-col">
          {# Power card (always shown) #}
          <div class="card">
            <div class="card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#4A9B5D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"/>
                <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
              </svg>
            </div>
            <div class="card-text">
              <div class="card-value">{{ data.total_pv_power_wc | formatInt }}</div>
              <div class="card-unit">Wc</div>
              <div class="card-label">Puissance installée</div>
            </div>
          </div>

          {# Panels card #}
          {% if data.number_of_panels %}
          <div class="card">
            <div class="card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#4A9B5D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <line x1="12" y1="3" x2="12" y2="17"/><line x1="2" y1="10" x2="22" y2="10"/>
                <line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
            </div>
            <div class="card-text">
              <div class="card-value">{{ data.number_of_panels }}</div>
              <div class="card-unit">panneaux</div>
              <div class="card-label">Nombre de panneaux</div>
            </div>
          </div>
          {% endif %}

          {# Orientation card #}
          {% if data.orientation_deg %}
          <div class="card">
            <div class="card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#4A9B5D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="#4A9B5D" opacity="0.3"/>
              </svg>
            </div>
            <div class="card-text">
              <div class="card-value">{{ data.orientation_deg }}°</div>
              <div class="card-unit">&nbsp;</div>
              <div class="card-label">Orientation</div>
            </div>
          </div>
          {% endif %}

          {# Tilt card #}
          {% if data.tilt_deg %}
          <div class="card">
            <div class="card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#4A9B5D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 20L2 20"/><path d="M4 20L18 6"/><path d="M18 6L18 14"/>
                <path d="M14 10L18 6" stroke-dasharray="2 2"/>
              </svg>
            </div>
            <div class="card-text">
              <div class="card-value">{{ data.tilt_deg }}°</div>
              <div class="card-unit">&nbsp;</div>
              <div class="card-label">Inclinaison</div>
            </div>
          </div>
          {% endif %}
        </div>

        {% if data.system_image %}
          <div class="system-image-col">
            <div class="system-image-wrap">
              <img src="{{ data.system_image }}" alt="" class="system-image">
              <div class="system-image-fade"></div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
