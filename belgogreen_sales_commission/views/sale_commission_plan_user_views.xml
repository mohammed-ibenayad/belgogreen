<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree/List View for Commission Plan User Assignments -->
        <record id="view_sale_commission_plan_user_tree" model="ir.ui.view">
            <field name="name">sale.commission.plan.user.tree</field>
            <field name="model">sale.commission.plan.user</field>
            <field name="arch" type="xml">
                <list string="Affectations des utilisateurs" editable="bottom">
                    <field name="plan_id" string="Plan" readonly="1"/>
                    <field name="user_id" string="Utilisateur"/>
                    <field name="role_id" string="Rôle"/>
                    <field name="role_sequence" string="Niveau" readonly="1"/>
                    <field name="manager_id" string="Manager"/>
                    <field name="direct_sale_percentage_display" string="Vente Directe %" readonly="1"/>
                    <field name="override_percentage_display" string="Supervision %" readonly="1"/>
                    <field name="date_from" string="Date début" optional="show"/>
                    <field name="date_to" string="Date fin" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Form View for Commission Plan User Assignments -->
        <record id="view_sale_commission_plan_user_form" model="ir.ui.view">
            <field name="name">sale.commission.plan.user.form</field>
            <field name="model">sale.commission.plan.user</field>
            <field name="arch" type="xml">
                <form string="Affectation utilisateur au plan">
                    <sheet>
                        <group>
                            <group>
                                <field name="plan_id" string="Plan de commission"/>
                                <field name="user_id" string="Utilisateur"/>
                                <field name="role_id" string="Rôle"/>
                                <field name="role_sequence" string="Niveau hiérarchique" readonly="1"/>
                            </group>
                            <group>
                                <field name="manager_id" string="Manager"/>
                                <field name="date_from" string="Date de début"/>
                                <field name="date_to" string="Date de fin"/>
                            </group>
                        </group>
                        <group string="Pourcentages de commission (depuis la configuration des rôles)">
                            <group>
                                <field name="direct_sale_percentage_display" string="Vente Directe %" readonly="1"/>
                                <field name="override_percentage_display" string="Supervision %" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
