<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree/List View for Commission Plan User Assignments -->
        <record id="view_sale_commission_plan_user_tree" model="ir.ui.view">
            <field name="name">sale.commission.plan.user.tree</field>
            <field name="model">sale.commission.plan.user</field>
            <field name="arch" type="xml">
                <tree string="Plan User Assignments" editable="bottom">
                    <field name="plan_id" string="Plan" readonly="1"/>
                    <field name="user_id" string="User"/>
                    <field name="role_id" string="Role"/>
                    <field name="role_sequence" string="Level" readonly="1"/>
                    <field name="manager_id" string="Manager"/>
                    <field name="direct_sale_percentage_display" string="Direct Sale %" readonly="1"/>
                    <field name="override_percentage_display" string="Override %" readonly="1"/>
                    <field name="date_from" string="From Date" optional="show"/>
                    <field name="date_to" string="To Date" optional="show"/>
                    <field name="company_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- Form View for Commission Plan User Assignments -->
        <record id="view_sale_commission_plan_user_form" model="ir.ui.view">
            <field name="name">sale.commission.plan.user.form</field>
            <field name="model">sale.commission.plan.user</field>
            <field name="arch" type="xml">
                <form string="Plan User Assignment">
                    <sheet>
                        <group>
                            <group>
                                <field name="plan_id" string="Commission Plan"/>
                                <field name="user_id" string="User"/>
                                <field name="role_id" string="Role"/>
                                <field name="role_sequence" string="Hierarchy Level" readonly="1"/>
                            </group>
                            <group>
                                <field name="manager_id" string="Manager"/>
                                <field name="date_from" string="Start Date"/>
                                <field name="date_to" string="End Date"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <group string="Commission Percentages (from role configuration)">
                            <group>
                                <field name="direct_sale_percentage_display" string="Direct Sale %" readonly="1"/>
                                <field name="override_percentage_display" string="Override %" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
