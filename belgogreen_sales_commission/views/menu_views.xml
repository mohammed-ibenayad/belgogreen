<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Smart Entry Point Action - Redirects based on user role -->
        <record id="action_commission_smart_entry" model="ir.actions.server">
            <field name="name">Point d'entrée des commissions</field>
            <field name="model_id" ref="model_sale_commission"/>
            <field name="state">code</field>
            <field name="code">
# Smart redirect based on user role
if env.user.has_group('belgogreen_sales_commission.group_commission_manager'):
    # Manager: Show unpaid commissions
    action = {
        'type': 'ir.actions.act_window',
        'res_model': 'sale.commission',
        'view_mode': 'list,form',
        'name': 'Commissions non payées',
        'context': {'search_default_can_be_paid': 1, 'search_default_group_user': 1},
        'domain': [],
    }
else:
    # Regular user: Show dashboard
    action = {
        'type': 'ir.actions.client',
        'tag': 'commission_dashboard',
        'name': 'Tableau de bord',
    }
            </field>
        </record>

        <!-- Main Menu (Single entry point for all users) -->
        <menuitem id="menu_commission_root"
                  name="Commissions"
                  web_icon="belgogreen_sales_commission,static/description/icon.svg"
                  action="action_commission_smart_entry"
                  sequence="75"
                  groups="belgogreen_sales_commission.group_commission_user,belgogreen_sales_commission.group_commission_manager"/>

        <!-- Dashboard Menu (for users) -->
        <menuitem id="menu_commission_dashboard"
                  name="Tableau de bord"
                  parent="menu_commission_root"
                  action="action_commission_dashboard"
                  sequence="1"
                  groups="belgogreen_sales_commission.group_commission_user"/>

        <!-- My Commission Menu (for users) -->
        <menuitem id="menu_my_commission"
                  name="Mes commissions"
                  parent="menu_commission_root"
                  sequence="10"
                  groups="belgogreen_sales_commission.group_commission_user"/>

        <menuitem id="menu_my_commission_overview"
                  name="Aperçu"
                  parent="menu_my_commission"
                  action="action_sale_commission_my"
                  sequence="10"/>

        <menuitem id="menu_my_commission_claims"
                  name="Mes réclamations"
                  parent="menu_my_commission"
                  action="action_sale_commission_claim_my"
                  sequence="20"/>

        <menuitem id="menu_team_commissions"
                  name="Commissions d'équipe"
                  parent="menu_my_commission"
                  action="action_sale_commission_team"
                  sequence="30"/>

        <!-- Commission Management (for managers) -->
        <menuitem id="menu_commission_management"
                  name="Management"
                  parent="menu_commission_root"
                  sequence="20"
                  groups="belgogreen_sales_commission.group_commission_manager"/>

        <!-- Stats Submenu -->
        <menuitem id="menu_commission_stats"
                  name="Statistiques"
                  parent="menu_commission_management"
                  sequence="10"/>

        <menuitem id="menu_commission_all"
                  name="Toutes les commissions"
                  parent="menu_commission_stats"
                  action="action_sale_commission_all"
                  sequence="10"/>

        <menuitem id="menu_commission_unpaid"
                  name="Commissions non payées"
                  parent="menu_commission_stats"
                  action="action_sale_commission_unpaid"
                  sequence="20"/>

        <!-- Tracking Submenu (Suivi) -->
        <menuitem id="menu_commission_tracking"
                  name="Suivi"
                  parent="menu_commission_management"
                  sequence="20"/>

        <menuitem id="menu_commission_manual_create"
                  name="Créer une Commission"
                  parent="menu_commission_tracking"
                  action="action_commission_manual_wizard"
                  sequence="5"
                  groups="belgogreen_sales_commission.group_commission_manager"/>

        <menuitem id="menu_commission_deductions_management"
                  name="Déductions"
                  parent="menu_commission_tracking"
                  action="action_commission_deduction"
                  sequence="10"/>

        <!-- DISABLED: Custom payment model removed, use standard account.payment
        <menuitem id="menu_commission_payments"
                  name="Paiements"
                  parent="menu_commission_tracking"
                  action="action_sale_commission_payment"
                  sequence="20"/>
        -->

        <menuitem id="menu_commission_claims"
                  name="Réclamations"
                  parent="menu_commission_tracking"
                  action="action_sale_commission_claim_all"
                  sequence="30"/>

        <!-- Configuration Menu -->
        <menuitem id="menu_commission_configuration"
                  name="Configuration"
                  parent="menu_commission_root"
                  sequence="100"
                  groups="belgogreen_sales_commission.group_commission_manager"/>

        <!-- Plans Submenu -->
        <menuitem id="menu_plans_management"
                  name="Plans"
                  parent="menu_commission_configuration"
                  sequence="10"/>

        <menuitem id="menu_commission_plans"
                  name="Plans de commission"
                  parent="menu_plans_management"
                  action="action_bgg_commission_plan"
                  sequence="10"/>

        <menuitem id="menu_commission_role_config"
                  name="Configuration des paliers"
                  parent="menu_plans_management"
                  action="action_hr_commission_role_config"
                  sequence="20"/>

        <menuitem id="menu_sale_commission_role"
                  name="Gestion des rôles"
                  parent="menu_plans_management"
                  action="action_sale_commission_role"
                  sequence="30"
                  groups="belgogreen_sales_commission.group_commission_manager"/>

        <!-- Hierarchy Management Submenu - DISABLED (incompatible with plan-based architecture) -->
        <!--
        <menuitem id="menu_hierarchy_management"
                  name="Hiérarchie"
                  parent="menu_commission_configuration"
                  sequence="20"/>

        <menuitem id="menu_team_hierarchy"
                  name="Structure d'équipe"
                  parent="menu_hierarchy_management"
                  action="action_team_hierarchy"
                  sequence="10"/>

        <menuitem id="menu_hierarchy_anomalies"
                  name="Anomalies"
                  parent="menu_hierarchy_management"
                  action="belgogreen_sales_commission.action_hierarchy_anomalies"
                  sequence="30"/>
        -->

    </data>
</odoo>
