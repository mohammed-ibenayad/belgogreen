<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_sale_commission_role_form" model="ir.ui.view">
        <field name="name">sale.commission.role.form</field>
        <field name="model">sale.commission.role</field>
        <field name="arch" type="xml">
            <form string="Rôle de Commission">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_users"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users"
                                invisible="user_count == 0">
                            <field name="user_count" widget="statinfo" string="Utilisateurs"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archivé" bg_color="bg-danger"
                            invisible="active"/>

                    <group>
                        <group>
                            <field name="name" placeholder="ex. Commercial, Chef d'équipe"/>
                            <field name="code" placeholder="ex. COM, CE, DC"/>
                            <field name="sequence"
                                   help="Les nombres inférieurs = bas de la hiérarchie (ex. 10=Commercial, 20=Chef d'équipe, 30=Directeur)"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="is_base_role"
                                   help="Cochez si c'est le rôle de base qui crée des commissions à partir des ventes"/>
                            <field name="requires_manager"
                                   help="Les utilisateurs avec ce rôle doivent avoir un manager assigné"/>
                            <field name="can_manage_subordinates"
                                   help="Les utilisateurs avec ce rôle peuvent avoir des membres d'équipe"/>
                        </group>
                    </group>

                    <group>
                        <field name="description" placeholder="Décrivez les responsabilités de ce rôle et sa position dans la hiérarchie..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_sale_commission_role_tree" model="ir.ui.view">
        <field name="name">sale.commission.role.tree</field>
        <field name="model">sale.commission.role</field>
        <field name="arch" type="xml">
            <list string="Rôles de Commission"
                  decoration-muted="not active">
                <field name="sequence" string="Ordre" widget="handle"/>
                <field name="name" string="Nom"/>
                <field name="code" string="Code"/>
                <field name="is_base_role" string="Rôle de Base"/>
                <field name="requires_manager" string="Nécessite un Manager"/>
                <field name="can_manage_subordinates" string="Peut Gérer des Subordonnés"/>
                <field name="user_count" string="Nb d'Utilisateurs"/>
                <field name="commission_count" string="Nb de Commissions"/>
                <field name="active" string="Actif" widget="boolean_toggle"/>
                <field name="company_id" string="Société" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_sale_commission_role_kanban" model="ir.ui.view">
        <field name="name">sale.commission.role.kanban</field>
        <field name="model">sale.commission.role</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="sequence"/>
                <field name="user_count"/>
                <field name="commission_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <span class="o_kanban_record_subtitle">
                                        <field name="code"/> (Niveau <field name="sequence"/>)
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="description"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge badge-pill">
                                        <i class="fa fa-users" title="Utilisateurs"/> <field name="user_count"/> utilisateurs
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span class="badge badge-pill badge-success">
                                        <i class="fa fa-money" title="Commissions"/> <field name="commission_count"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sale_commission_role_search" model="ir.ui.view">
        <field name="name">sale.commission.role.search</field>
        <field name="model">sale.commission.role</field>
        <field name="arch" type="xml">
            <search string="Rôles de Commission">
                <field name="name"/>
                <field name="code"/>

                <filter name="active_roles" string="Actif" domain="[('active', '=', True)]"/>
                <filter name="inactive_roles" string="Archivé" domain="[('active', '=', False)]"/>

                <separator/>
                <filter name="base_roles" string="Rôles de base" domain="[('is_base_role', '=', True)]"/>
                <filter name="management_roles" string="Rôles de management" domain="[('can_manage_subordinates', '=', True)]"/>
                <filter name="top_level" string="Niveau supérieur" domain="[('requires_manager', '=', False)]"/>

                <group>
                    <filter name="group_by_company" string="Société" context="{'group_by': 'company_id'}"/>
                    <filter name="group_by_hierarchy" string="Niveau hiérarchique" context="{'group_by': 'sequence'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sale_commission_role" model="ir.actions.act_window">
        <field name="name">Rôles de Commission</field>
        <field name="res_model">sale.commission.role</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active_roles': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier rôle de commission !
            </p>
            <p>
                Définissez les rôles dans votre hiérarchie de commissions (ex. Commercial, Chef d'équipe, Directeur commercial).
                Définissez le niveau hiérarchique (séquence) pour déterminer qui rend compte à qui.
            </p>
            <p>
                Les numéros de séquence inférieurs représentent les positions les plus basses dans la hiérarchie :
                <ul>
                    <li>10 = Commercial (bas)</li>
                    <li>20 = Chef d'équipe (milieu)</li>
                    <li>30 = Directeur commercial (haut)</li>
                </ul>
            </p>
        </field>
    </record>

</odoo>
