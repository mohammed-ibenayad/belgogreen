<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_commission_deduction_tree" model="ir.ui.view">
            <field name="name">commission.deduction.tree</field>
            <field name="model">commission.deduction</field>
            <field name="arch" type="xml">
                <list string="Déductions de Commission"
                      decoration-success="state == 'applied'"
                      decoration-warning="state == 'pending'"
                      decoration-muted="state == 'cancelled'">
                    <field name="name" string="Référence" width="120px"/>
                    <field name="user_id" string="Vendeur" width="150px"/>
                    <field name="deduction_type" string="Type" width="140px"/>
                    <field name="deduction_category" string="Catégorie"
                           widget="badge"
                           decoration-danger="deduction_category == 'mandatory'"
                           decoration-info="deduction_category == 'optional'"
                           width="100px"/>
                    <field name="amount" string="Montant" sum="Total" width="100px"/>
                    <field name="date" string="Date" width="90px"/>
                    <field name="state" string="État"
                           widget="badge"
                           decoration-success="state == 'applied'"
                           decoration-warning="state == 'pending'"
                           width="90px"/>
                    <field name="description" string="Description" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_commission_deduction_form" model="ir.ui.view">
            <field name="name">commission.deduction.form</field>
            <field name="model">commission.deduction</field>
            <field name="arch" type="xml">
                <form string="Déduction de Commission">
                    <header>
                        <button name="action_cancel"
                                string="Annuler"
                                type="object"
                                invisible="state in ['applied', 'cancelled']"
                                groups="belgogreen_sales_commission.group_commission_manager"
                                confirm="Êtes-vous sûr de vouloir annuler cette déduction ?"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,applied"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Informations de Déduction">
                                <field name="user_id" string="Vendeur" options="{'no_create': True}"/>
                                <field name="deduction_type" string="Type"/>
                                <field name="deduction_category" string="Catégorie"/>
                                <field name="date" string="Date"/>
                            </group>
                            <group string="Montant">
                                <field name="amount" string="Montant" class="oe_subtotal_footer_separator"/>
                                <field name="reference" string="Référence"/>
                            </group>
                        </group>

                        <separator string="Description"/>
                        <field name="description" nolabel="1" placeholder="Saisissez les détails de la déduction..." widget="text" options="{'rows': 8}"/>

                        <!-- Application Information -->
                        <group string="Application" invisible="state != 'applied'">
                            <field name="claim_id" string="Réclamation" readonly="1"/>
                            <field name="purchase_order_id" string="Bon de Commande" readonly="1"/>
                        </group>

                    </sheet>
                    <!-- Chatter -->
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_commission_deduction_search" model="ir.ui.view">
            <field name="name">commission.deduction.search</field>
            <field name="model">commission.deduction</field>
            <field name="arch" type="xml">
                <search string="Déductions de Commission">
                    <field name="name" string="Référence"/>
                    <field name="user_id" string="Vendeur"/>
                    <field name="deduction_type" string="Type"/>
                    <field name="reference" string="Référence"/>
                    <separator/>
                    <filter string="En Attente" name="pending" domain="[('state', '=', 'pending')]"/>
                    <filter string="Appliquée" name="applied" domain="[('state', '=', 'applied')]"/>
                    <filter string="Annulée" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <filter string="Obligatoire" name="mandatory" domain="[('deduction_category', '=', 'mandatory')]"/>
                    <filter string="Optionnelle" name="optional" domain="[('deduction_category', '=', 'optional')]"/>
                    <separator/>
                    <filter string="Acomptes" name="down_payment" domain="[('deduction_type', '=', 'down_payment')]"/>
                    <filter string="Frais de Service" name="service_fee" domain="[('deduction_type', '=', 'service_fee')]"/>
                    <separator/>
                    <filter string="Ce Mois" name="this_month"
                            domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                     ('date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <group>
                        <filter string="Vendeur" name="group_user" context="{'group_by': 'user_id'}"/>
                        <filter string="Type" name="group_type" context="{'group_by': 'deduction_type'}"/>
                        <filter string="Catégorie" name="group_category" context="{'group_by': 'deduction_category'}"/>
                        <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_commission_deduction" model="ir.actions.act_window">
            <field name="name">Déductions</field>
            <field name="res_model">commission.deduction</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_pending': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aucune déduction trouvée
                </p>
                <p>
                    Créez des déductions pour suivre les acomptes, les frais de service et autres montants
                    à déduire des paiements de commissions.
                </p>
            </field>
        </record>

        <record id="action_commission_deduction_pending" model="ir.actions.act_window">
            <field name="name">Déductions en Attente</field>
            <field name="res_model">commission.deduction</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', '=', 'pending')]</field>
            <field name="context">{}</field>
        </record>

    </data>
</odoo>
