<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Manual Commission Wizard Form View -->
        <record id="view_commission_manual_wizard_form" model="ir.ui.view">
            <field name="name">commission.manual.wizard.form</field>
            <field name="model">commission.manual.wizard</field>
            <field name="arch" type="xml">
                <form string="Créer une Commission">
                    <sheet>
                        <group>
                            <group string="Bénéficiaire">
                                <field name="user_id" string="Vendeur" options="{'no_create': True, 'no_open': True}"/>
                                <field name="commission_type"/>
                            </group>
                            <group string="Montant">
                                <field name="currency_id" invisible="1"/>
                                <field name="base_amount" string="Montant de Base" widget="monetary"/>
                                <field name="commission_percentage" string="Pourcentage de Commission (%)"/>
                                <field name="manual_amount" string="Montant de la Commission" widget="monetary" readonly="1" class="oe_subtotal_footer_separator"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <field name="role_id" invisible="1"/>
                        <field name="sale_order_count" invisible="1"/>

                        <notebook>
                            <page string="Commandes de Vente" name="sale_orders">
                                <field name="sale_order_ids" nolabel="1" widget="many2many" options="{'no_create': True}"/>
                            </page>
                            <page string="Description" name="description">
                                <group col="1">
                                    <field name="description" nolabel="1" placeholder="Entrez la raison de la création de cette commission..." rows="10"/>
                                </group>
                            </page>
                        </notebook>

                        <group>
                            <field name="create_po_immediately"
                                   string="Créer le Bon de Commande Immédiatement"
                                   help="Si coché, un bon de commande sera créé immédiatement après la sauvegarde de la commission"/>
                        </group>
                    </sheet>

                    <footer>
                        <button string="Créer la Commission" name="action_create_commission" type="object" class="btn-primary"/>
                        <button string="Annuler" name="action_cancel" type="object" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action to open the wizard -->
        <record id="action_commission_manual_wizard" model="ir.actions.act_window">
            <field name="name">Créer une Commission</field>
            <field name="res_model">commission.manual.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_view_types" eval="False"/>
        </record>

        <!-- Menu item for Manual Commission Creation (Manager only) -->
        <menuitem
            id="menu_commission_manual_create"
            name="Créer une Commission"
            parent="belgogreen_sales_commission.menu_commission_tracking"
            action="action_commission_manual_wizard"
            sequence="5"
            groups="belgogreen_sales_commission.group_commission_manager"/>

    </data>
</odoo>
