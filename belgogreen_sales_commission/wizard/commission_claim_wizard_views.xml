<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Commission Claim Wizard Form -->
    <record id="view_commission_claim_wizard_form" model="ir.ui.view">
        <field name="name">commission.claim.wizard.form</field>
        <field name="model">commission.claim.wizard</field>
        <field name="arch" type="xml">
            <form string="Réclamer le paiement de commission">
                <group>
                    <group>
                        <field name="commission_count" string="Nombre de commissions" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="total_amount" string="Montant total des commissions" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"
                               class="oe_subtotal_footer_separator"/>
                    </group>
                </group>

                <group string="Commissions sélectionnées">
                    <field name="commission_ids" nolabel="1">
                        <list create="false" delete="false" edit="false"
                              decoration-success="status == 'paid'"
                              decoration-warning="status == 'claimed'"
                              decoration-muted="status == 'cancelled'">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="sale_order_id"/>
                            <field name="commission_percentage"/>
                            <field name="commission_amount" sum="Total" widget="monetary"/>
                            <field name="status" invisible="1"/>
                        </list>
                    </field>
                </group>

                <div class="alert alert-info" role="alert">
                    <p><strong>Important :</strong></p>
                    <ul>
                        <li>Vous êtes sur le point de créer une réclamation pour <strong><field name="commission_count" readonly="1" nolabel="1" class="oe_inline"/> commission(s)</strong></li>
                        <li>Montant total à réclamer : <strong><field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1" nolabel="1" class="oe_inline"/></strong></li>
                        <li>La réclamation sera créée à l'état de brouillon - vous pourrez la réviser et ajouter d'autres commissions</li>
                        <li>Soumettez la réclamation lorsque vous êtes prêt pour l'examen de la direction</li>
                    </ul>
                </div>

                <footer>
                    <button name="action_confirm_claim" string="Créer la réclamation" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Commission Claim Wizard Action (Users Only) -->
    <record id="action_commission_claim_wizard" model="ir.actions.act_window">
        <field name="name">Réclamer le paiement de commission</field>
        <field name="res_model">commission.claim.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_sale_commission"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('belgogreen_sales_commission.group_commission_user'))]"/>
    </record>

</odoo>
