<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Manual Commission Plan -->
        <record id="plan_manual_commission" model="sale.commission.plan">
            <field name="name">Manual Commission Plan</field>
            <field name="plan_type">hierarchical</field>
            <field name="require_invoice_paid" eval="False"/>
            <field name="is_default" eval="False"/>
            <field name="state">approved</field>
            <field name="description">
Special plan for manually created commissions.
Commission amounts are specified directly by managers, not calculated from percentages.
This plan does not use automatic percentage calculations.
            </field>
        </record>

        <!-- Role Configurations with 0% (not used for manual commissions) -->
        <record id="config_manual_salesperson" model="hr.commission.role.config">
            <field name="plan_id" ref="plan_manual_commission"/>
            <field name="role_id" ref="role_salesperson"/>
            <field name="direct_sale_percentage">0.0</field>
            <field name="override_percentage">0.0</field>
        </record>

        <record id="config_manual_team_leader" model="hr.commission.role.config">
            <field name="plan_id" ref="plan_manual_commission"/>
            <field name="role_id" ref="role_team_leader"/>
            <field name="direct_sale_percentage">0.0</field>
            <field name="override_percentage">0.0</field>
        </record>

        <record id="config_manual_sales_director" model="hr.commission.role.config">
            <field name="plan_id" ref="plan_manual_commission"/>
            <field name="role_id" ref="role_sales_director"/>
            <field name="direct_sale_percentage">0.0</field>
            <field name="override_percentage">0.0</field>
        </record>

    </data>
</odoo>
