<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The nightly commission generation cron has been removed: commissions
        are generated exclusively from sale orders (button / bulk action),
        under the control of a commission manager.

        The <delete> below removes the old scheduled action from existing
        databases on module upgrade. It searches by name (not by xml id) so it
        is idempotent and safe on fresh installs where the record never existed.
    -->
    <delete model="ir.cron" search="[('cron_name', '=', 'Generate Sales Commissions')]"/>
</odoo>
