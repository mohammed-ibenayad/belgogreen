<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_po_send_invoice_request" model="mail.template">
            <field name="name">Commission PO: Request Invoice</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">Commission Payment Approved - Please Send Invoice (PO: {{ object.name }})</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; padding: 20px; max-width: 800px;">
    <h2 style="color: #2c3e50;">Commission Payment Approved</h2>

    <p>Hello <strong t-out="object.partner_id.name or ''"/>,</p>

    <p>Your commission claim has been approved and a Purchase Order has been issued.</p>

    <h3 style="color: #34495e; margin-top: 25px;">Purchase Order Details:</h3>
    <table style="border-collapse: collapse; width: 100%; margin: 20px 0; border: 1px solid #ddd;">
        <tr style="background-color: #f8f9fa;">
            <td style="padding: 12px; border: 1px solid #ddd; font-weight: bold; width: 40%;">PO Number:</td>
            <td style="padding: 12px; border: 1px solid #ddd;" t-out="object.name or ''"/>
        </tr>
        <tr>
            <td style="padding: 12px; border: 1px solid #ddd; font-weight: bold;">Date:</td>
            <td style="padding: 12px; border: 1px solid #ddd;" t-out="format_date(object.date_order)"/>
        </tr>
        <tr style="background-color: #f8f9fa;">
            <td style="padding: 12px; border: 1px solid #ddd; font-weight: bold;">Gross Commission:</td>
            <td style="padding: 12px; border: 1px solid #ddd;" t-out="format_amount(sum(object.claim_ids.mapped('total_amount')), object.currency_id)"/>
        </tr>
        <tr>
            <td style="padding: 12px; border: 1px solid #ddd; font-weight: bold;">Deductions:</td>
            <td style="padding: 12px; border: 1px solid #ddd; color: #e74c3c;">-<t t-out="format_amount(sum(object.claim_ids.mapped('total_deductions')), object.currency_id)"/></td>
        </tr>
        <tr style="background-color: #e8f5e9;">
            <td style="padding: 12px; border: 1px solid #ddd; font-weight: bold;">Net Amount to Invoice:</td>
            <td style="padding: 12px; border: 1px solid #ddd; font-weight: bold; font-size: 16px; color: #27ae60;" t-out="format_amount(object.amount_total, object.currency_id)"/>
        </tr>
    </table>

    <div style="background-color: #fff3cd; border-left: 4px solid #ffc107; padding: 15px; margin: 25px 0;">
        <h3 style="color: #856404; margin-top: 0;">Next Steps:</h3>
        <ol style="margin: 10px 0; padding-left: 20px; color: #856404;">
            <li style="margin-bottom: 10px;">Please send us your invoice for the net amount: <strong t-out="format_amount(object.amount_total, object.currency_id)"/></li>
            <li style="margin-bottom: 10px;">Reference PO number <strong t-out="object.name or ''"/> on your invoice</li>
            <li style="margin-bottom: 10px;">Email your invoice to: <strong t-out="object.company_id.email or 'accounting@company.com'"/></li>
        </ol>
    </div>

    <div style="background-color: #f8f9fa; padding: 15px; border-radius: 5px; margin: 25px 0;">
        <h4 style="margin-top: 0; color: #2c3e50;">Commission Breakdown:</h4>
        <p style="margin: 5px 0;"><strong>Claims:</strong> <t t-out="', '.join(object.claim_ids.mapped('name'))"/></p>
        <p style="margin: 5px 0;"><strong>Number of Commissions:</strong> <t t-out="len(object.claim_ids.mapped('commission_ids'))"/></p>
    </div>

    <p style="margin-top: 25px;">Once we receive and process your invoice, payment will be issued according to our payment terms.</p>

    <p style="margin-top: 20px;">If you have any questions, please don't hesitate to contact us.</p>

    <p style="margin-top: 30px; color: #7f8c8d;">
        Best regards,<br/>
        <strong t-out="object.company_id.name or ''"/><br/>
        <t t-if="object.company_id.phone">Phone: <t t-out="object.company_id.phone"/><br/></t>
        <t t-if="object.company_id.email">Email: <t t-out="object.company_id.email"/><br/></t>
    </p>

    <hr style="border: none; border-top: 1px solid #ddd; margin: 30px 0;"/>

    <p style="font-size: 12px; color: #95a5a6; text-align: center;">
        This is an automated message. Please do not reply directly to this email.
    </p>
</div>
            </field>
        </record>

    </data>
</odoo>
