<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Searching a file also matches the folders above it: "S00466" finds
         every file of the S00466 project folders, sub-folders included. -->
    <record id="search_dms_file_folder_path" model="ir.ui.view">
        <field name="name">dms_file.search.folder.path</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.search_dms_file"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="string">Nom ou dossier</attribute>
                <attribute name="filter_domain">['|', ('name', 'ilike', self), ('directory_id.complete_name', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
