<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_ai_odoo_suggest_tree" model="ir.ui.view">
        <field name="name">ai.odoo.suggest.tree</field>
        <field name="model">ai.odoo.suggest</field>
        <field name="arch" type="xml">
            <tree string="AI Suggestions">
                <field name="name"/>
                <field name="user_id"/>
                <field name="channel_id"/>
                <field name="status"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ai_odoo_suggest_form" model="ir.ui.view">
        <field name="name">ai.odoo.suggest.form</field>
        <field name="model">ai.odoo.suggest</field>
        <field name="arch" type="xml">
            <form string="AI Suggestion">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="pending,transcribed,processed,confirmed,executed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_process" type="object" string="Process Audio" 
                                class="oe_stat_button" icon="fa-cogs"
                                invisible="status != 'pending'"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="channel_id"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="status"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Audio">
                            <field name="audio_filename"/>
                            <field name="audio_file" filename="audio_filename"/>
                        </page>
                        <page string="Transcription">
                            <field name="transcription" nolabel="1"/>
                        </page>
                        <page string="AI Response">
                            <field name="ai_response" nolabel="1"/>
                        </page>
                        <page string="Suggested Actions">
                            <field name="suggested_actions" nolabel="1"/>
                        </page>
                        <page string="Executed Actions">
                            <field name="executed_actions" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ai_odoo_suggest" model="ir.actions.act_window">
        <field name="name">AI Suggestions</field>
        <field name="res_model">ai.odoo.suggest</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_ai_odoo_suggest_root" name="AI Suggestions" sequence="100"/>
    <menuitem id="menu_ai_odoo_suggest" name="AI Suggestions" 
              parent="menu_ai_odoo_suggest_root" 
              action="action_ai_odoo_suggest" sequence="10"/>

    <!-- Configuration -->
    <record id="config_settings_view_form" model="ir.ui.view">
        <field name="name">config.settings.view.form.inherit.ai.odoo.suggest</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="AI Odoo Suggest" string="AI Odoo Suggest">
                    <h2>AI Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="openai_api_key"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="openai_api_key"/>
                                <div class="text-muted">
                                    API key for OpenAI services (Whisper for transcription, GPT for processing)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_openai_api_key" model="ir.model.fields">
        <field name="name">openai_api_key</field>
        <field name="model">res.config.settings</field>
        <field name="field_description">OpenAI API Key</field>
        <field name="ttype">char</field>
        <field name="size">100</field>
        <field name="config_parameter" eval="1"/>
    </record>
</odoo>