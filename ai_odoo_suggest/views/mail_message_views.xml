<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_message_form_inherit_ai_suggest" model="ir.ui.view">
        <field name="name">mail.message.form.inherit.ai.suggest</field>
        <field name="model">mail.message</field>
        <field name="inherit_id" ref="mail.mail_message_view_form"/>
        <field name="arch" type="xml">
            <field name="body" position="after">
                <notebook invisible="not ai_suggest_ids">
                    <page string="AI Suggestions">
                        <field name="ai_suggest_ids" readonly="1">
                            <tree>
                                <field name="name"/>
                                <field name="status" widget="badge"/>
                                <field name="create_date"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </field>
        </field>
    </record>
</odoo>