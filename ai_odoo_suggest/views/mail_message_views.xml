<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit mail.message form view - add ai_suggest_ids field -->
    <record id="view_mail_message_form_inherit_ai_suggest" model="ir.ui.view">
        <field name="name">mail.message.form.inherit.ai.suggest</field>
        <field name="model">mail.message</field>
        <field name="inherit_id" ref="mail.mail_message_view_form"/>
        <field name="arch" type="xml">
            <!-- Add the field after body field -->
            <!-- ai_suggest_ids is invisible because it's accessed programmatically, not displayed in UI -->
            <field name="body" position="after">
                <field name="ai_suggest_ids" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>