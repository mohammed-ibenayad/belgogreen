<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bgg_staging_rebuild_log_list" model="ir.ui.view">
        <field name="name">bgg.staging.rebuild.log.list</field>
        <field name="model">bgg.staging.rebuild.log</field>
        <field name="arch" type="xml">
            <list string="Historique" create="false" edit="false" delete="false">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="build_state"
                       decoration-info="build_state in ('pending','building')"
                       decoration-success="build_state == 'success'"
                       decoration-danger="build_state == 'failure'"
                       decoration-muted="build_state == 'unknown'"
                       widget="badge"/>
                <field name="build_description" optional="show"/>
                <field name="build_url" widget="url" string="Lien" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bgg_staging_rebuild_log_form" model="ir.ui.view">
        <field name="name">bgg.staging.rebuild.log.form</field>
        <field name="model">bgg.staging.rebuild.log</field>
        <field name="arch" type="xml">
            <form string="Reconstruction Staging" create="false" edit="false">
                <header>
                    <button name="action_refresh_status" type="object"
                            string="Actualiser l'état" class="btn-primary"
                            invisible="status != 'success'"/>
                    <button name="action_open_build" type="object"
                            string="Ouvrir le build" class="btn-secondary"
                            invisible="not build_url"/>
                    <field name="build_state" widget="statusbar"
                           statusbar_visible="pending,building,success,failure"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span invisible="build_state != 'pending'">Reconstruction en attente</span>
                            <span invisible="build_state != 'building'">Reconstruction en cours…</span>
                            <span invisible="build_state != 'success'">Staging prêt</span>
                            <span invisible="build_state != 'failure'">Échec de la reconstruction</span>
                            <span invisible="build_state != 'unknown'">État inconnu</span>
                        </h1>
                        <p class="text-muted" invisible="not build_description">
                            <field name="build_description" readonly="1" nolabel="1"/>
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="create_date" string="Lancée le"/>
                            <field name="user_id"/>
                            <field name="strategy"/>
                        </group>
                        <group>
                            <field name="build_url" widget="url"/>
                        </group>
                    </group>

                    <!-- Détails techniques, visibles uniquement en mode développeur -->
                    <group string="Détails techniques" groups="base.group_no_one">
                        <group>
                            <field name="branch"/>
                            <field name="source_branch"/>
                            <field name="commit_sha"/>
                            <field name="build_context"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="http_status"/>
                            <field name="last_status_check"/>
                        </group>
                    </group>
                    <group string="Message" invisible="not message" groups="base.group_no_one">
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bgg_staging_rebuild_log" model="ir.actions.act_window">
        <field name="name">Historique des reconstructions</field>
        <field name="res_model">bgg.staging.rebuild.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
