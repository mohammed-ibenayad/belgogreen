[options]
; BelGoGreen: Odoo 19 Community + OCA. Our repository is mounted read-only
; in /mnt/extra-addons/belgogreen (OCA modules included).
addons_path = /mnt/extra-addons/belgogreen,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo

; --- Security ---
admin_passwd = __ADMIN_PASSWD__
dbfilter = ^belgogreen$
list_db = False

; --- Behind nginx: the container listens on all its interfaces, the host
; publishes the ports on 127.0.0.1 only (docker-compose.yml) ---
proxy_mode = True
http_interface = 0.0.0.0

; --- 2 vCPU: 2 workers + 1 cron thread; workers > 0 serves the websocket port ---
workers = 2
max_cron_threads = 1
limit_memory_soft = 1073741824
limit_memory_hard = 1342177280
limit_time_cpu = 600
limit_time_real = 1200
limit_request = 8192
