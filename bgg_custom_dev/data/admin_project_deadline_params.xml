<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Admin project deadlines (Dossier): delays applied to the project created
        for a sale order, from its confirmation date ("Signature du BC").

        bgg.admin_project_deadline_rules holds JSON. Edit it in Settings >
        Technical > System Parameters. noupdate: created on install/upgrade if
        missing, never overwrites a value an admin has changed.

            { "<payment term name>": { "day_type": "business" | "calendar",
                                       "<product category name>": <days>, ... },
              ... }

        - the first-level key is the payment term name as shown in Odoo
          (case-insensitive, any installed language); a payment term absent
          from this map gets no dates (e.g. Financement RW);
        - "business" (jours ouvrables) counts Monday to Friday only, no
          holidays; "calendar" (jours calendrier) counts every day;
        - the other keys are product category names (the product's category
          or one of its parents, case-insensitive), e.g. "Panneaux" for
          "All / Saleable / Panneaux";
        - when the order holds products from several listed categories, the
          longest delay wins.
    -->
    <data noupdate="1">
        <record id="admin_project_deadline_rules" model="ir.config_parameter">
            <field name="key">bgg.admin_project_deadline_rules</field>
            <field name="value">{
  "Paiement immédiat": {"day_type": "business", "Panneaux": 10, "Onduleurs": 10, "Batteries": 10, "PAC": 15, "Isolation": 20},
  "50% maintenant, le solde à l'installation": {"day_type": "business", "Panneaux": 10, "Onduleurs": 10, "Batteries": 10, "PAC": 15, "Isolation": 20},
  "Financement": {"day_type": "calendar", "Panneaux": 15, "Onduleurs": 15, "Batteries": 15, "PAC": 20, "Isolation": 25},
  "Financement (Banque/Courtier client)": {"day_type": "calendar", "Panneaux": 15, "Onduleurs": 15, "Batteries": 15, "PAC": 20, "Isolation": 25}
}</field>
        </record>
    </data>
</odoo>
