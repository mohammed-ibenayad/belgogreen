<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="appointment_status_wizard_form" model="ir.ui.view">
        <field name="name">appointment.status.wizard.form</field>
        <field name="model">appointment.status.wizard</field>
        <field name="arch" type="xml">
            <form string="Statut du rendez-vous">
                <group>
                    <field name="calendar_event_id" invisible="1"/>
                    <field name="new_status" invisible="1"/>
                    <field name="x_avis_count"/>
                    <field name="x_recommandation_count"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirmer" type="object"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard for "Attended" status -->
    <record id="action_appointment_status_attended" model="ir.actions.act_window">
        <field name="name">Rendez-vous effectué - Avis &amp; Recommandations</field>
        <field name="res_model">appointment.status.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_new_status': 'attended'}</field>
    </record>

    <!-- Action to open wizard for "No Show" status -->
    <record id="action_appointment_status_no_show" model="ir.actions.act_window">
        <field name="name">No Show - Avis &amp; Recommandations</field>
        <field name="res_model">appointment.status.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_new_status': 'no_show'}</field>
    </record>

</odoo>
