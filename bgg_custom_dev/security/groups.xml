<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_bgg_dashboard" model="res.groups">
        <field name="name">BGG Dashboard</field>
        <field name="comment">Grants access to BGG Dashboards (Suivi Commercial, Avis &amp; Recommandations)</field>
    </record>

    <!--
        "Responsable Dossier": internal users who can be picked as the
        Responsable of a sale order (Dossier tab). The Responsable acts as the
        project manager of the order: follows up the admins' activities and
        field service until the order is delivered to the client.
        Group and field labels are intentionally kept in French (business
        wording); they are not meant to be translated.
    -->
    <record id="group_responsable_dossier" model="res.groups">
        <field name="name">Responsable Dossier</field>
        <field name="comment">Utilisateurs internes pouvant être désignés Responsable d'un bon de commande (onglet Dossier) : suivi des activités des admins et du service sur site jusqu'à la livraison au client.</field>
    </record>

    <!--
        "Responsable Dossier Admin": the only users allowed to set or change
        the Responsable of a sale order (Dossier tab). Being a Responsable
        (group above) does not grant this right.
    -->
    <record id="group_responsable_dossier_admin" model="res.groups">
        <field name="name">Responsable Dossier Admin</field>
        <field name="comment">Utilisateurs autorisés à désigner ou modifier le Responsable d'un bon de commande (onglet Dossier).</field>
    </record>

    <!--
        "Direction": access to the AMSS Management dashboard (company-wide
        sales, projects and invoicing figures).
    -->
    <record id="group_direction" model="res.groups">
        <field name="name">Direction</field>
        <field name="comment">Accès au tableau de bord AMSS Management (onglet Direction) : chiffres de toute la société (ventes, projets admin, facturation, encaissements).</field>
    </record>

    <!--
        "AMSS ADMIN": created in Odoo Studio (__custom__.group_58), adopted by
        this module (the 19.0.2.1.0 migration gives the existing group this
        xmlid, so it is not created twice). Runs "Créer tâches SSS" from the
        sale order and sees the RDV columns of the quotation list.
    -->
    <data noupdate="1">
        <record id="group_amss_admin" model="res.groups">
            <field name="name">AMSS ADMIN</field>
        </record>
    </data>

    <!--
        The "Commercial" and "Call Center" roles used by the no-show workflow are
        NOT defined here: they were created manually outside the custom modules.
        They are resolved by name at runtime (see calendar_event.py) and linked
        to module xmlids by the post-init hook (see __init__.py).
    -->
</odoo>
