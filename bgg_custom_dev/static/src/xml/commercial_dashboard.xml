<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="commercial.dashboard">
        <div class="commercial_dashboard" t-ref="root">
            <!-- Error Display -->
            <div t-if="state.error" class="alert alert-danger m-3" role="alert">
                <strong>Erreur:</strong> <t t-esc="state.error"/>
            </div>

            <!-- Loading -->
            <div t-if="state.loading" class="text-center p-5">
                <i class="fa fa-spinner fa-spin fa-3x text-muted"/>
                <p class="mt-3 text-muted">Chargement...</p>
            </div>

            <!-- Dashboard Content -->
            <div t-if="!state.loading and state.data and !state.error">
                <!-- Header -->
                <div class="cd_header">
                    <div class="cd_header_left">
                        <h1>Suivi Commercial</h1>
                    </div>
                    <div class="cd_header_center">
                        <button class="btn btn-sm btn-outline-secondary" t-on-click="onPrevMonth">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <span class="cd_month_label" t-esc="state.data.month_label"/>
                        <button class="btn btn-sm btn-outline-secondary" t-on-click="onNextMonth">
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>
                    <div class="cd_header_right">
                        <button class="btn btn-primary btn-sm" t-on-click="onRefresh">
                            <i class="fa fa-refresh"/> Actualiser
                        </button>
                    </div>
                </div>

                <!-- Main Table -->
                <div class="cd_table_wrapper">
                    <table class="cd_table">
                        <thead>
                            <tr>
                                <th class="cd_section_header" colspan="2">
                                    <t t-esc="state.data.month_label"/>
                                </th>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <th class="cd_user_header">
                                        <t t-esc="user.name.split(' ')[0]"/>
                                    </th>
                                </t>
                                <th class="cd_total_header">TOTAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- RDV CALL Section -->
                            <tr class="cd_section_row">
                                <td class="cd_section_label" rowspan="5">RDV CALL</td>
                                <td class="cd_row_label">Total</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserCallData(user.id).total || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_call_total.total || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_present">Présent</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserCallData(user.id).attended || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_call_total.attended || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_noshow">No-Show</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserCallData(user.id).no_show || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_call_total.no_show || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_refused">Refusé</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserCallData(user.id).cancelled || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_call_total.cancelled || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_booked">Réservé</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserCallData(user.id).booked || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_call_total.booked || 0"/></td>
                            </tr>

                            <!-- Spacer -->
                            <tr class="cd_spacer_row"><td t-att-colspan="state.data.users.length + 3"/></tr>

                            <!-- RDV COMMERCIAL Section -->
                            <tr class="cd_section_row">
                                <td class="cd_section_label" rowspan="5">RDV COMMERCIAL</td>
                                <td class="cd_row_label">Total</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserComData(user.id).total || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_commercial_total.total || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_present">Présent</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserComData(user.id).attended || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_commercial_total.attended || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_noshow">No-Show</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserComData(user.id).no_show || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_commercial_total.no_show || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_refused">Refusé</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserComData(user.id).cancelled || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_commercial_total.cancelled || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_booked">Réservé</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserComData(user.id).booked || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_commercial_total.booked || 0"/></td>
                            </tr>

                            <!-- Spacer -->
                            <tr class="cd_spacer_row"><td t-att-colspan="state.data.users.length + 3"/></tr>

                            <!-- TAUX PRÉSENCE -->
                            <tr class="cd_section_row">
                                <td class="cd_section_label cd_section_blue" rowspan="2">TAUX PRÉSENCE</td>
                                <td class="cd_row_label">Call</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="formatPercent(getUserDerived(user.id).tx_presence_call)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="formatPercent(state.data.derived_total.tx_presence_call)"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label">Commercial</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="formatPercent(getUserDerived(user.id).tx_presence_com)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="formatPercent(state.data.derived_total.tx_presence_com)"/></td>
                            </tr>

                            <!-- Spacer -->
                            <tr class="cd_spacer_row"><td t-att-colspan="state.data.users.length + 3"/></tr>

                            <!-- Nbre de vies -->
                            <tr class="cd_highlight_row">
                                <td class="cd_section_label cd_section_blue" colspan="1">Nbre de vies</td>
                                <td class="cd_row_label"/>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_bold"><t t-esc="getUserDerived(user.id).nbre_vies || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_bold"><t t-esc="state.data.derived_total.nbre_vies || 0"/></td>
                            </tr>

                            <!-- Spacer -->
                            <tr class="cd_spacer_row"><td t-att-colspan="state.data.users.length + 3"/></tr>

                            <!-- Financial KPIs -->
                            <tr class="cd_financial_row">
                                <td class="cd_section_label cd_section_green" colspan="1">CA BRUT</td>
                                <td class="cd_row_label"/>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_currency"><t t-esc="formatCurrency(getUserDerived(user.id).ca_brut)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_currency"><t t-esc="formatCurrency(state.data.derived_total.ca_brut)"/></td>
                            </tr>
                            <tr class="cd_financial_row">
                                <td class="cd_section_label cd_section_green" colspan="1">CA NET</td>
                                <td class="cd_row_label"/>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_currency"><t t-esc="formatCurrency(getUserDerived(user.id).ca_net)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_currency"><t t-esc="formatCurrency(state.data.derived_total.ca_net)"/></td>
                            </tr>
                            <tr class="cd_financial_row cd_annule_row">
                                <td class="cd_section_label cd_section_red" colspan="1">ANNULÉ</td>
                                <td class="cd_row_label"/>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_currency"><t t-esc="formatCurrency(getUserDerived(user.id).ca_annule)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_currency"><t t-esc="formatCurrency(state.data.derived_total.ca_annule)"/></td>
                            </tr>
                            <tr class="cd_financial_row">
                                <td class="cd_section_label" colspan="1">TX Annulation</td>
                                <td class="cd_row_label"/>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="formatPercent(getUserDerived(user.id).tx_annulation)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="formatPercent(state.data.derived_total.tx_annulation)"/></td>
                            </tr>
                            <tr class="cd_financial_row">
                                <td class="cd_section_label" colspan="1">Panier Moyen</td>
                                <td class="cd_row_label"/>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_currency"><t t-esc="formatCurrency(getUserDerived(user.id).panier_moyen)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_currency"><t t-esc="formatCurrency(state.data.derived_total.panier_moyen)"/></td>
                            </tr>
                            <tr class="cd_financial_row cd_conversion_row">
                                <td class="cd_section_label" colspan="1">TX Conversion</td>
                                <td class="cd_row_label"/>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_bold"><t t-esc="formatPercent(getUserDerived(user.id).tx_conversion)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_bold"><t t-esc="formatPercent(state.data.derived_total.tx_conversion)"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
