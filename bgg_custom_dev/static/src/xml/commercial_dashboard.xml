<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="commercial.dashboard">
        <div class="commercial_dashboard" t-ref="root">
            <!-- Error Display -->
            <div t-if="state.error" class="alert alert-danger m-3" role="alert">
                <strong>Erreur:</strong> <t t-esc="state.error"/>
            </div>

            <!-- Loading -->
            <div t-if="state.loading" class="text-center p-5">
                <i class="fa fa-spinner fa-spin fa-3x text-muted"/>
                <p class="mt-3 text-muted">Chargement...</p>
            </div>

            <!-- Dashboard Content -->
            <div t-if="!state.loading and state.data and !state.error" style="display:flex;flex-direction:column;height:100%;">
                <!-- Header -->
                <div class="cd_header">
                    <div class="cd_header_left">
                        <h1>Suivi Commercial</h1>
                    </div>
                    <div class="cd_header_center">
                        <button class="btn btn-sm btn-outline-secondary" t-on-click="onPrevPeriod">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <span class="cd_month_label" t-esc="state.data.period_label"/>
                        <button class="btn btn-sm btn-outline-secondary" t-on-click="onNextPeriod">
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>
                    <div class="cd_header_right" style="display:flex;gap:8px;">
                        <button class="btn btn-success btn-sm" t-on-click="onExportExcel">
                            <i class="fa fa-file-excel-o"/> Excel
                        </button>
                        <button class="btn btn-primary btn-sm" t-on-click="onRefresh">
                            <i class="fa fa-refresh"/> Actualiser
                        </button>
                    </div>
                </div>

                <!-- Filters -->
                <div class="cd_filters">
                    <div class="cd_filter_group">
                        <label>Période :</label>
                        <select t-on-change="onPeriodTypeChange">
                            <option value="month" t-att-selected="state.periodType === 'month' ? 'selected' : undefined">Mois</option>
                            <option value="quarter" t-att-selected="state.periodType === 'quarter' ? 'selected' : undefined">Trimestre</option>
                            <option value="year" t-att-selected="state.periodType === 'year' ? 'selected' : undefined">Année</option>
                            <option value="custom" t-att-selected="state.periodType === 'custom' ? 'selected' : undefined">Personnalisé</option>
                        </select>
                    </div>
                    <t t-if="state.periodType === 'custom'">
                        <div class="cd_filter_sep"/>
                        <div class="cd_filter_group">
                            <label>Du :</label>
                            <input type="date" t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                        </div>
                        <div class="cd_filter_group">
                            <label>Au :</label>
                            <input type="date" t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                        </div>
                    </t>
                    <div class="cd_filter_sep"/>
                    <div class="cd_filter_group">
                        <label>Commercial :</label>
                        <select t-on-change="onUserFilterChange">
                            <option value="">Tous</option>
                            <t t-foreach="state.availableUsers" t-as="u" t-key="u.id">
                                <option t-att-value="u.id" t-att-selected="state.filterUserId === u.id ? 'selected' : undefined">
                                    <t t-esc="u.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                    <div class="cd_filter_sep"/>
                    <div class="cd_filter_group">
                        <label>Société :</label>
                        <select t-on-change="onCompanyFilterChange">
                            <option value="">Toutes</option>
                            <t t-foreach="state.availableCompanies" t-as="c" t-key="c.id">
                                <option t-att-value="c.id" t-att-selected="state.filterCompanyId === c.id ? 'selected' : undefined">
                                    <t t-esc="c.name"/>
                                </option>
                            </t>
                        </select>
                    </div>
                </div>

                <!-- Main Table -->
                <div class="cd_table_wrapper">
                    <table class="cd_table">
                        <thead>
                            <tr>
                                <th class="cd_section_header" colspan="2">
                                    <t t-esc="state.data.period_label"/>
                                </th>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <th class="cd_user_header">
                                        <t t-esc="user.name.split(' ')[0]"/>
                                    </th>
                                </t>
                                <th class="cd_total_header">TOTAL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- RDV CALL CENTER Section -->
                            <tr class="cd_section_row">
                                <td class="cd_section_label" rowspan="5">RDV CALL CENTER</td>
                                <td class="cd_row_label">Total</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserCallData(user.id).total || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_call_total.total || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_present">Présent</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserCallData(user.id).attended || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_call_total.attended || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_noshow">No-Show</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserCallData(user.id).no_show || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_call_total.no_show || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_refused">Refusé</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserCallData(user.id).cancelled || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_call_total.cancelled || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_booked">Réservé</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserCallData(user.id).booked || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_call_total.booked || 0"/></td>
                            </tr>

                            <!-- Spacer -->
                            <tr class="cd_spacer_row"><td t-att-colspan="state.data.users.length + 3"/></tr>

                            <!-- RDV COMMERCIAL Section -->
                            <tr class="cd_section_row">
                                <td class="cd_section_label" rowspan="5">RDV COMMERCIAL</td>
                                <td class="cd_row_label">Total</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserComData(user.id).total || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_commercial_total.total || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_present">Présent</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserComData(user.id).attended || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_commercial_total.attended || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_noshow">No-Show</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserComData(user.id).no_show || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_commercial_total.no_show || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_refused">Refusé</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserComData(user.id).cancelled || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_commercial_total.cancelled || 0"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label cd_status_booked">Réservé</td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="getUserComData(user.id).booked || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="state.data.rdv_commercial_total.booked || 0"/></td>
                            </tr>

                            <!-- Spacer -->
                            <tr class="cd_spacer_row"><td t-att-colspan="state.data.users.length + 3"/></tr>

                            <!-- TAUX PRÉSENCE -->
                            <tr class="cd_section_row">
                                <td class="cd_section_label cd_section_blue" rowspan="2" title="Taux de présence = Présents / Total RDV">TAUX PRÉSENCE</td>
                                <td class="cd_row_label">
                                    Call
                                    <i class="fa fa-info-circle cd_info_icon" title="Taux de présence Call = Présents Call Center / Total RDV Call Center"/>
                                </td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="formatPercent(getUserDerived(user.id).tx_presence_call)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="formatPercent(state.data.derived_total.tx_presence_call)"/></td>
                            </tr>
                            <tr>
                                <td class="cd_row_label">
                                    Commercial
                                    <i class="fa fa-info-circle cd_info_icon" title="Taux de présence Commercial = Présents Commercial / Total RDV Commercial"/>
                                </td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="formatPercent(getUserDerived(user.id).tx_presence_com)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="formatPercent(state.data.derived_total.tx_presence_com)"/></td>
                            </tr>

                            <!-- Spacer -->
                            <tr class="cd_spacer_row"><td t-att-colspan="state.data.users.length + 3"/></tr>

                            <!-- Ventes Confirmées -->
                            <tr class="cd_highlight_row">
                                <td class="cd_section_label cd_section_blue" colspan="1" title="Nombre de commandes dont l'état est 'Confirmé' ou 'Verrouillé' (state sale / done)">VENTES CONFIRMÉES</td>
                                <td class="cd_row_label">
                                    <i class="fa fa-info-circle cd_info_icon" title="Ventes Confirmées = nombre de commandes à l'état Confirmé ou Verrouillé (state ∈ {sale, done})."/>
                                </td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_bold"><t t-esc="getUserDerived(user.id).nbre_vies || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_bold"><t t-esc="state.data.derived_total.nbre_vies || 0"/></td>
                            </tr>

                            <!-- Ventes Annulées -->
                            <tr class="cd_highlight_row cd_annule_row">
                                <td class="cd_section_label cd_section_red" colspan="1" title="Nombre de commandes dont l'état est 'Annulé' (state cancel)">VENTES ANNULÉES</td>
                                <td class="cd_row_label">
                                    <i class="fa fa-info-circle cd_info_icon" title="Ventes Annulées = nombre de commandes à l'état Annulé (state = cancel)."/>
                                </td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_bold"><t t-esc="getUserDerived(user.id).ventes_annulees || 0"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_bold"><t t-esc="state.data.derived_total.ventes_annulees || 0"/></td>
                            </tr>

                            <!-- Spacer -->
                            <tr class="cd_spacer_row"><td t-att-colspan="state.data.users.length + 3"/></tr>

                            <!-- Financial KPIs -->
                            <tr class="cd_financial_row">
                                <td class="cd_section_label cd_section_green" colspan="1" title="Somme HT de toutes les commandes de la période (confirmées + annulées)">CA BRUT</td>
                                <td class="cd_row_label">
                                    <i class="fa fa-info-circle cd_info_icon" title="CA BRUT = somme HT de toutes les commandes de la période (confirmées + annulées)."/>
                                </td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_currency"><t t-esc="formatCurrency(getUserDerived(user.id).ca_brut)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_currency"><t t-esc="formatCurrency(state.data.derived_total.ca_brut)"/></td>
                            </tr>
                            <tr class="cd_financial_row">
                                <td class="cd_section_label cd_section_green" colspan="1" title="CA NET = CA BRUT − CA ANNULÉ">CA NET</td>
                                <td class="cd_row_label">
                                    <i class="fa fa-info-circle cd_info_icon" title="CA NET = CA BRUT − CA ANNULÉ."/>
                                </td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_currency"><t t-esc="formatCurrency(getUserDerived(user.id).ca_net)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_currency"><t t-esc="formatCurrency(state.data.derived_total.ca_net)"/></td>
                            </tr>
                            <tr class="cd_financial_row cd_annule_row">
                                <td class="cd_section_label cd_section_red" colspan="1" title="Somme HT des commandes annulées">ANNULÉ</td>
                                <td class="cd_row_label">
                                    <i class="fa fa-info-circle cd_info_icon" title="ANNULÉ = somme HT des commandes annulées."/>
                                </td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_currency"><t t-esc="formatCurrency(getUserDerived(user.id).ca_annule)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_currency"><t t-esc="formatCurrency(state.data.derived_total.ca_annule)"/></td>
                            </tr>
                            <tr class="cd_financial_row">
                                <td class="cd_section_label" colspan="1" title="Taux d'annulation = CA ANNULÉ / CA BRUT">TX ANNULATION</td>
                                <td class="cd_row_label">
                                    <i class="fa fa-info-circle cd_info_icon" title="TX ANNULATION = CA ANNULÉ / CA BRUT."/>
                                </td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell"><t t-esc="formatPercent(getUserDerived(user.id).tx_annulation)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell"><t t-esc="formatPercent(state.data.derived_total.tx_annulation)"/></td>
                            </tr>
                            <tr class="cd_financial_row">
                                <td class="cd_section_label" colspan="1" title="Panier moyen = CA NET / Ventes Confirmées">PANIER MOYEN</td>
                                <td class="cd_row_label">
                                    <i class="fa fa-info-circle cd_info_icon" title="PANIER MOYEN = CA NET / Ventes Confirmées."/>
                                </td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_currency"><t t-esc="formatCurrency(getUserDerived(user.id).panier_moyen)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_currency"><t t-esc="formatCurrency(state.data.derived_total.panier_moyen)"/></td>
                            </tr>
                            <tr class="cd_financial_row cd_conversion_row">
                                <td class="cd_section_label" colspan="1" title="Taux de conversion = (Ventes Confirmées + Ventes Annulées) / Total Présents. Les annulations sont incluses pour refléter la capacité de transformation du commercial, indépendamment des annulations ultérieures.">TX CONVERSION</td>
                                <td class="cd_row_label">
                                    <i class="fa fa-info-circle cd_info_icon" title="TX CONVERSION = (Ventes Confirmées + Ventes Annulées) / (Présents Call + Présents Commercial). Les annulations ultérieures sont incluses au numérateur pour refléter la capacité de transformation du commercial (le suivi des annulations se fait via TX ANNULATION)."/>
                                </td>
                                <t t-foreach="state.data.users" t-as="user" t-key="user.id">
                                    <td class="cd_cell cd_bold"><t t-esc="formatPercent(getUserDerived(user.id).tx_conversion)"/></td>
                                </t>
                                <td class="cd_cell cd_total_cell cd_bold"><t t-esc="formatPercent(state.data.derived_total.tx_conversion)"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
