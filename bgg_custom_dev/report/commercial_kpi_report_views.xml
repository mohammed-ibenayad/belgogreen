<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="commercial_kpi_report_view_tree" model="ir.ui.view">
        <field name="name">commercial.kpi.report.tree</field>
        <field name="model">commercial.kpi.report</field>
        <field name="arch" type="xml">
            <list string="KPI Suivi Commercial">
                <field name="date"/>
                <field name="user_id"/>
                <field name="appointment_type_id" optional="hide"/>
                <field name="appointment_category"/>
                <field name="appointment_status"/>
                <field name="appointment_count" sum="Total"/>
                <field name="attended_count" sum="Total"/>
                <field name="no_show_count" sum="Total"/>
                <field name="cancelled_count" sum="Total"/>
                <field name="booked_count" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="commercial_kpi_report_view_pivot" model="ir.ui.view">
        <field name="name">commercial.kpi.report.pivot</field>
        <field name="model">commercial.kpi.report</field>
        <field name="arch" type="xml">
            <pivot string="KPI Suivi Commercial">
                <field name="user_id" type="row"/>
                <field name="appointment_category" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="appointment_count" type="measure"/>
                <field name="attended_count" type="measure"/>
                <field name="no_show_count" type="measure"/>
                <field name="cancelled_count" type="measure"/>
                <field name="booked_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="commercial_kpi_report_view_graph" model="ir.ui.view">
        <field name="name">commercial.kpi.report.graph</field>
        <field name="model">commercial.kpi.report</field>
        <field name="arch" type="xml">
            <graph string="KPI Suivi Commercial" type="bar">
                <field name="user_id"/>
                <field name="attended_count" type="measure"/>
                <field name="no_show_count" type="measure"/>
                <field name="cancelled_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="commercial_kpi_report_view_search" model="ir.ui.view">
        <field name="name">commercial.kpi.report.search</field>
        <field name="model">commercial.kpi.report</field>
        <field name="arch" type="xml">
            <search string="Recherche KPI Commercial">
                <field name="user_id"/>
                <field name="appointment_type_id"/>
                <field name="appointment_category"/>
                <filter name="this_month" string="Ce mois"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%%Y-%%m-%%d')),
                                 ('date', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="last_month" string="Mois dernier"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=1, day=1)).strftime('%%Y-%%m-%%d')),
                                 ('date', '&lt;', (context_today() - relativedelta(day=1)).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="this_quarter" string="Ce trimestre"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(month=((context_today().month - 1) // 3) * 3 + 1, day=1)).strftime('%%Y-%%m-%%d')),
                                 ('date', '&lt;', (context_today() + relativedelta(month=((context_today().month - 1) // 3) * 3 + 4, day=1)).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <filter name="category_call" string="RDV Call"
                        domain="[('appointment_category', '=', 'call')]"/>
                <filter name="category_commercial" string="RDV Commercial"
                        domain="[('appointment_category', '=', 'commercial')]"/>
                <separator/>
                <filter name="group_user" string="Par commercial" context="{'group_by': 'user_id'}"/>
                <filter name="group_month" string="Par mois" context="{'group_by': 'date:month'}"/>
                <filter name="group_category" string="Par catégorie" context="{'group_by': 'appointment_category'}"/>
                <filter name="group_status" string="Par statut" context="{'group_by': 'appointment_status'}"/>
                <filter name="group_type" string="Par type de RDV" context="{'group_by': 'appointment_type_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_commercial_kpi_report" model="ir.actions.act_window">
        <field name="name">KPI Suivi Commercial (Pivot)</field>
        <field name="res_model">commercial.kpi.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="commercial_kpi_report_view_search"/>
        <field name="context">{'search_default_this_month': 1, 'search_default_group_user': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune donnée de rendez-vous trouvée.
            </p>
            <p>
                Les KPI de suivi commercial apparaîtront ici une fois que des rendez-vous
                seront enregistrés dans le système.
            </p>
        </field>
    </record>

</odoo>
