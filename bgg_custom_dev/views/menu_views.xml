<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_bgg_custom_dev_root"
              name="BGG Dashboards"
              groups="bgg_custom_dev.group_bgg_dashboard"
              web_icon="fa-line-chart,#875A7B,#ffffff"
              sequence="100"/>

    <!-- Suivi Rendez-vous -->
    <menuitem id="menu_bgg_appointment_tracking"
              name="Suivi Rendez-vous"
              parent="menu_bgg_custom_dev_root"
              groups="bgg_custom_dev.group_bgg_dashboard"
              sequence="10"/>

    <menuitem id="menu_bgg_commercial_dashboard"
              name="Suivi Commercial"
              parent="menu_bgg_appointment_tracking"
              action="bgg_custom_dev.action_commercial_dashboard"
              groups="bgg_custom_dev.group_bgg_dashboard"
              sequence="10"/>

    <menuitem id="menu_bgg_call_center_dashboard"
              name="Suivi Call Center"
              parent="menu_bgg_appointment_tracking"
              action="bgg_custom_dev.action_call_center_dashboard"
              groups="bgg_custom_dev.group_bgg_dashboard"
              sequence="20"/>

    <menuitem id="menu_bgg_avis_count"
              name="Avis &amp; Recommandations (Pivot)"
              parent="menu_bgg_appointment_tracking"
              action="bgg_custom_dev.action_avis_count_report"
              groups="bgg_custom_dev.group_bgg_dashboard"
              sequence="30"/>

    <!-- Call center working queue (top-level).
         Visibility is restricted to the manually-created "Call Center" group by
         the post-init hook (the group has no xmlid to reference here). -->
    <menuitem id="menu_bgg_noshow_recyclage_root"
              name="No-shows à recycler"
              web_icon="fa-recycle,#017e84,#ffffff"
              sequence="101"/>

    <menuitem id="menu_bgg_noshow_recyclage_queue"
              name="No-shows à recycler"
              parent="menu_bgg_noshow_recyclage_root"
              action="bgg_custom_dev.action_noshow_recyclage_queue"
              sequence="10"/>

</odoo>
