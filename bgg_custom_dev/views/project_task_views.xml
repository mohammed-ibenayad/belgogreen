<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        "Bloqué" task state of the admin projects (see project_task.py): an
        open blocked task sets its project to Bloqué. The state widget offers
        "Bloqué" only on tasks of admin projects (x_is_admin_dossier_project,
        loaded below); only the Responsable Dossier groups may set or remove
        it (checked server side). The reason is written in the chatter.
    -->
    <record id="view_task_form2_inherit_blocked" model="ir.ui.view">
        <field name="name">project.task.form.inherit.blocked</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='tag_ids']" position="before">
                <field name="x_is_admin_dossier_project" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!--
        SSS tasks laid out as the Field Service task form: left, Assignés
        then Date prévue (planned start -> deadline, the end of the range)
        and Temps alloué; right, Étiquettes, the client with its address and
        "Voir l'itinéraire", the contact number (x_sss_partner_id: the task's
        client, shown with its address). "Date limite" (the deadline, shown as
        the end of Date prévue) is hidden on SSS tasks only; other tasks keep
        the standard form.
    -->
    <record id="view_task_form2_inherit_sss" model="ir.ui.view">
        <field name="name">project.task.form.inherit.sss</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//group/field[@name='user_ids']" position="after">
                <field name="x_is_sss_task" invisible="1"/>
                <label for="planned_date_begin" string="Date prévue" invisible="not x_is_sss_task"/>
                <div class="o_row" invisible="not x_is_sss_task">
                    <field name="planned_date_begin" widget="daterange"
                           options="{'end_date_field': 'date_deadline', 'always_range': True, 'show_seconds': False}"/>
                    <field name="date_deadline" invisible="1"/>
                </div>
                <field name="allocated_hours" string="Temps alloué" widget="float_time"
                       invisible="not x_is_sss_task"/>
            </xpath>
            <!-- the client with its address under Étiquettes, then the route and
                 the contact number. Its own field: Community hides the standard
                 client on projects that are not billable (the SSS ones), and the
                 same field twice in a form does not show -->
            <xpath expr="//group/field[@name='tag_ids']" position="after">
                <field name="x_sss_partner_id" widget="res_partner_many2one"
                       context="{'show_address': 1, 'res_partner_search_mode': 'customer'}"
                       invisible="not x_is_sss_task"/>
                <div colspan="2" invisible="not x_is_sss_task or not x_sss_partner_id">
                    <button name="action_bgg_open_itinerary" type="object" class="btn-link ps-0"
                            icon="fa-arrow-right" string="Voir l'itinéraire"/>
                </div>
                <field name="partner_phone" string="Numéro de contact" widget="phone"
                       invisible="not x_is_sss_task"/>
            </xpath>
            <!-- the standard client: not on SSS tasks (shown above) -->
            <xpath expr="//field[@name='partner_id'][hasclass('o_task_customer_field')]" position="attributes">
                <attribute name="invisible" add="x_is_sss_task" separator=" or "/>
            </xpath>
            <!-- "Date limite" is the end of Date prévue: not on SSS tasks -->
            <xpath expr="//label[@for='date_deadline']" position="attributes">
                <attribute name="invisible" add="x_is_sss_task" separator=" or "/>
            </xpath>
            <xpath expr="//div[@id='date_deadline_and_recurring_task']" position="attributes">
                <attribute name="invisible" add="x_is_sss_task" separator=" or "/>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_tree_base_inherit_blocked" model="ir.ui.view">
        <field name="name">project.task.list.inherit.blocked</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_view_tree_base"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="x_is_admin_dossier_project" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_task_kanban_inherit_blocked" model="ir.ui.view">
        <field name="name">project.task.kanban.inherit.blocked</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="x_is_admin_dossier_project"/>
            </xpath>
        </field>
    </record>

    <record id="view_task_search_form_project_base_inherit_blocked" model="ir.ui.view">
        <field name="name">project.task.search.inherit.blocked</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form_project_base"/>
        <field name="arch" type="xml">
            <filter name="open_tasks" position="after">
                <filter string="Bloquées" name="bgg_blocked_tasks" domain="[('state', '=', '05_blocked')]"/>
            </filter>
        </field>
    </record>
</odoo>
