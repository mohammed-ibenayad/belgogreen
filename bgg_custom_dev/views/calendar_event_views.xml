<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit calendar.event form view -->
    <record id="view_calendar_event_form_inherit_bgg" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.bgg</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">

            <!-- Alert banner prompting user to fill in KPI tab after status
                 change; hidden once a number of reviews or referrals is set -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning text-center" role="alert"
                     invisible="x_rdv_status not in ('attended', 'no_show') or not x_rdv_type_id or x_avis_count or x_recommandation_count">
                    Pensez à renseigner les informations dans l'onglet
                    <strong>Avis &amp; Recommandations</strong>.
                </div>
                <div class="alert alert-warning text-center" role="alert"
                     invisible="x_rdv_status != 'no_show' or x_appointment_ref not in ['APT-ENERG-CNT', 'APT-NISOL-CNT'] or x_noshow_disposition">
                    Veuillez compléter l'état du
                    <strong>Suivi No-show par commercial</strong>.
                </div>
            </xpath>

            <!-- Control fields hoisted out of the (potentially hidden) page so
                 their values are always loaded for the visibility rule. -->
            <xpath expr="//notebook" position="before">
                <!-- RDV type and status (own fields). Hidden by the Enterprise
                     bridge while Enterprise Appointments shows its own. -->
                <group name="bgg_rdv" string="Rendez-vous">
                    <group>
                        <field name="x_rdv_type_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="x_rdv_status"/>
                    </group>
                </group>
                <field name="x_appointment_ref" invisible="1"/>
                <field name="x_noshow_disposition" invisible="1"/>
                <field name="x_user_can_edit_noshow_disposition" invisible="1"/>
            </xpath>

            <!-- Add new "Avis &amp; Recommandations" tab in the notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Avis &amp; Recommandations" name="page_avis_recommandations"
                      invisible="not x_rdv_type_id">
                    <group>
                        <group string="Avis clients">
                            <field name="x_avis_count"/>
                        </group>
                        <group string="Recommandations">
                            <field name="x_recommandation_count"/>
                        </group>
                    </group>
                </page>

                <!-- No-show treatment workflow (call-center appointments only) -->
                <page string="Suivi No-show par commercial" name="page_noshow"
                      invisible="x_appointment_ref not in ['APT-ENERG-CNT', 'APT-NISOL-CNT'] or (x_rdv_status != 'no_show' and not x_noshow_disposition)">
                    <group>
                        <group string="Suivi commercial">
                            <field name="x_noshow_disposition"
                                   placeholder="Veuillez compléter"
                                   readonly="not x_user_can_edit_noshow_disposition"/>
                        </group>
                        <group string="Disponibilité call center">
                            <field name="x_noshow_date" readonly="1"/>
                            <!-- Hide the call-center availability date once a suivi
                                 commercial is set: a no-show with a disposition is
                                 never recycled (see the "No-shows à recycler" filter,
                                 which requires x_noshow_disposition = False), so the
                                 "Disponible call center le" date would be misleading. -->
                            <field name="x_noshow_available_date" readonly="1"
                                   invisible="x_noshow_disposition"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Le commercial est prioritaire jusqu'à la date « Disponible call center ».
                        S'il replanifie le rendez-vous ou indique « Suivi en cours »,
                        le call center ne le reprend pas. Sinon (suivi commercial vide) le no-show
                        devient recyclable par le call center après cette date. Précisez tout
                        détail dans la note (journal du rendez-vous).
                    </div>
                </page>

                <!-- Booking questionnaire answers -->
                <page string="Questionnaire" name="page_rdv_answers" invisible="not x_rdv_answers">
                    <field name="x_rdv_answers" readonly="1" nolabel="1"/>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Add a "No-shows à recycler" filter to the calendar events search view.
         Candidates = call-center no-shows the commercial is no longer following
         up (empty 'Suivi commercial') AND whose priority window has elapsed, so
         the list shows only no-shows actually available for the call center to
         take. The window length comes from the system parameter (see the field's
         search method); the reschedule guard enforces it again on write. -->
    <record id="view_calendar_event_search_inherit_bgg" model="ir.ui.view">
        <field name="name">calendar.event.search.inherit.bgg</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="x_rdv_type_id"/>
                <separator/>
                <filter name="rdv_booked" string="RDV réservés" domain="[('x_rdv_status', '=', 'booked')]"/>
                <filter name="rdv_attended" string="RDV présents" domain="[('x_rdv_status', '=', 'attended')]"/>
                <filter name="rdv_no_show" string="RDV no-show" domain="[('x_rdv_status', '=', 'no_show')]"/>
                <filter name="rdv_cancelled" string="RDV annulés" domain="[('x_rdv_status', '=', 'cancelled')]"/>
                <filter name="group_rdv_type" string="Type de RDV" context="{'group_by': 'x_rdv_type_id'}"/>
                <filter name="group_rdv_status" string="Statut du RDV" context="{'group_by': 'x_rdv_status'}"/>
                <separator/>
                <filter name="noshow_a_recycler"
                        string="No-shows à recycler"
                        domain="[('x_rdv_status', '=', 'no_show'), ('x_rdv_type_id.code', 'in', ['APT-ENERG-CNT', 'APT-NISOL-CNT']), ('x_noshow_disposition', '=', False), ('x_noshow_available_date', '&lt;=', datetime.datetime.now())]"/>
            </xpath>
        </field>
    </record>

</odoo>
