<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit calendar.event form view -->
    <record id="view_calendar_event_form_inherit_bgg" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.bgg</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">

            <!-- Alert banner prompting user to fill in KPI tab after status change -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning text-center" role="alert"
                     invisible="appointment_status not in ('attended', 'no_show') or not appointment_type_id">
                    Pensez à renseigner les informations dans l'onglet
                    <strong>Avis &amp; Recommandations</strong>.
                </div>
            </xpath>

            <!-- Control fields hoisted out of the (potentially hidden) page so
                 their values are always loaded for the visibility rule. -->
            <xpath expr="//notebook" position="before">
                <field name="x_appointment_ref" invisible="1"/>
                <field name="x_noshow_disposition" invisible="1"/>
                <field name="x_user_is_commercial" invisible="1"/>
            </xpath>

            <!-- Add new "Avis &amp; Recommandations" tab in the notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Avis &amp; Recommandations" name="page_avis_recommandations"
                      invisible="not appointment_type_id">
                    <group>
                        <group string="Avis clients">
                            <field name="x_avis_count"/>
                        </group>
                        <group string="Recommandations">
                            <field name="x_recommandation_count"/>
                        </group>
                    </group>
                </page>

                <!-- No-show treatment workflow (call-center appointments only) -->
                <page string="Suivi No-show" name="page_noshow"
                      invisible="x_appointment_ref not in ['APT-ENERG-CNT', 'APT-NISOL-CNT'] or (appointment_status != 'no_show' and not x_noshow_disposition)">
                    <group>
                        <group string="Suivi commercial">
                            <field name="x_noshow_disposition"
                                   readonly="not x_user_is_commercial"/>
                        </group>
                        <group string="Disponibilité call center">
                            <field name="x_noshow_date" readonly="1"/>
                            <field name="x_noshow_available_date" readonly="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Le commercial est prioritaire jusqu'à la date « Disponible call center ».
                        S'il replanifie le rendez-vous ou indique « Client pas intéressé »,
                        le call center ne le reprend pas. Sinon le no-show devient recyclable
                        par le call center après cette date. Précisez tout détail dans la note
                        (journal du rendez-vous).
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Add a "No-shows à recycler" filter to the calendar events search view.
         Candidates = call-center no-shows the commercial has not closed
         ('Client pas intéressé') AND whose priority window has elapsed, so the
         list shows only no-shows actually available for the call center to take.
         The window length comes from the system parameter (see the field's
         search method); the reschedule guard enforces it again on write. -->
    <record id="view_calendar_event_search_inherit_bgg" model="ir.ui.view">
        <field name="name">calendar.event.search.inherit.bgg</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="noshow_a_recycler"
                        string="No-shows à recycler"
                        domain="[('appointment_status', '=', 'no_show'), ('appointment_type_id.x_appointment_ref', 'in', ['APT-ENERG-CNT', 'APT-NISOL-CNT']), ('x_noshow_disposition', '!=', 'pas_interesse'), ('x_noshow_available_date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time.max))]"/>
            </xpath>
        </field>
    </record>

</odoo>
