<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_feedback_form" model="ir.ui.view">
        <field name="name">user.feedback.form</field>
        <field name="model">user.feedback</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">Your feedback helps us improve!</div>
                    <group>
                        <field name="feedback" placeholder="How did you find the plugin ..."/>
                        <field name="wants_updates"/>
                        <group col="1" invisible="not wants_updates">
                            <field name="email" placeholder="your@email.com"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Submit" type="object" name="submit_feedback" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_feedback" model="ir.actions.act_window">
        <field name="name">Subscribe to Receive Beta Release Updates</field>
        <field name="res_model">user.feedback</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>