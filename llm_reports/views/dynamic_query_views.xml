<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <!-- Main Form View -->
   <record id="view_dynamic_query_report_form" model="ir.ui.view">
       <field name="name">dynamic.query.report.form</field>
       <field name="model">dynamic.query.report</field>
       <field name="arch" type="xml">
           <form string="Dynamic Query Report">
               <sheet>
                   <div class="alert alert-info" role="alert">
                       <p><strong>How to use:</strong> Type your query in natural language. The system will understand and find the relevant records.</p>
                       <p><strong>Example queries:</strong></p>
                       <ul>
                           <li>"Show me all sales orders created in the last 30 days with amount greater than 1000"</li>
                           <li>"Find customers from New York who made purchases this year"</li>
                           <li>"List all products with stock less than 10"</li>
                           <li>"Show all calendar events scheduled for tomorrow"</li>
                           <li>"Find appointments with the status 'Confirmed' for this week"</li>
                           <p></p>
                           <button name="%(llm_reports.action_open_feedback)d" string="Upcoming Release ->" type="action" class="btn-warning oe_highlight float-right"/>
                       </ul>
                   </div>
                   <group>
                       <field name="user_input" placeholder="Enter your query in natural language..." help="You can ask for any information about sales orders, customers, products, etc. Use natural language and be specific about conditions like dates, amounts, or status."/>
                       <field name="save_filter_checkbox" widget="boolean" help="Check this box to save the filter for future use."/>
                   </group>
               </sheet>
               <footer>
                   <button string="Submit (CTRL + Enter)" type="object" name="process_input" class="btn-primary"/>
                   <button string="Cancel" class="btn-secondary" special="cancel"/>                   
               </footer>
           </form>
       </field>
   </record>

   <!-- Main Action -->
   <record id="action_dynamic_query_report" model="ir.actions.act_window">
       <field name="name">AskOdoo</field>
       <field name="res_model">dynamic.query.report</field>
       <field name="view_mode">form</field>
       <field name="target">new</field>
       <field name="view_id" ref="view_dynamic_query_report_form"/>
   </record>

   <!-- Menu Items -->
   <menuitem id="menu_dynamic_query_report" name="AskOdoo"  action="action_dynamic_query_report" sequence="10" web_icon="llm_reports,static/description/icon.png"/> 
</odoo>