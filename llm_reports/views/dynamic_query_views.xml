<odoo>
    <!-- Form View for the Transient Model -->
    <record id="view_dynamic_query_report_form" model="ir.ui.view">
        <field name="name">dynamic.query.report.form</field>
        <field name="model">dynamic.query.report</field>
        <field name="arch" type="xml">
            <form string="Dynamic Query Report">
                <sheet>
                    <group>
                        <field name="user_input" placeholder="Enter your query (e.g., Show me all open sales orders)"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Submit" type="object" name="process_input" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to Open the Form View -->
    <record id="action_dynamic_query_report" model="ir.actions.act_window">
        <field name="name">Dynamic Query Report</field>
        <field name="res_model">dynamic.query.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_dynamic_query_report_form"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_dynamic_query_report_root" name="Dynamic Reporting"/>
    <menuitem id="menu_dynamic_query_report" name="Dynamic Query Report"
              parent="menu_dynamic_query_report_root"
              action="action_dynamic_query_report"
              sequence="10"/>
</odoo>