<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Booking form: the call-centre questionnaire -->
    <record id="resource_booking_view_form_bgg" model="ir.ui.view">
        <field name="name">resource.booking.form.bgg</field>
        <field name="model">resource.booking</field>
        <field name="inherit_id" ref="resource_booking.resource_booking_view_form"/>
        <field name="arch" type="xml">
            <field name="type_id" position="after">
                <field name="x_rdv_type_id"/>
            </field>
            <field name="description" position="before">
                <group name="bgg_questionnaire" string="Questionnaire" colspan="4">
                    <group>
                        <field name="x_street"/>
                        <field name="x_zip"/>
                        <field name="x_city"/>
                        <field name="x_country_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="x_need_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="x_spouse_name"/>
                        <field name="x_spouse_phone" widget="phone"/>
                        <field name="x_sms_confirmation"/>
                        <field name="x_on_behalf_id" options="{'no_create': True}"/>
                    </group>
                </group>
            </field>
        </field>
    </record>
</odoo>
