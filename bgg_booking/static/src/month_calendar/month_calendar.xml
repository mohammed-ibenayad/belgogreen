<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bgg_booking.MonthCalendar">
        <div class="o_bgg_month_calendar border rounded">
            <div class="d-flex align-items-center justify-content-between p-2 border-bottom">
                <button type="button" class="btn btn-light" aria-label="Mois précédent" title="Mois précédent"
                        t-att-disabled="!canGoBack" t-on-click="() => this.changeMonth(-1)">
                    <i class="fa fa-chevron-left" aria-hidden="true"/>
                </button>
                <span class="fs-5 text-capitalize" t-esc="monthLabel"/>
                <button type="button" class="btn btn-light" aria-label="Mois suivant" title="Mois suivant"
                        t-on-click="() => this.changeMonth(1)">
                    <i class="fa fa-chevron-right" aria-hidden="true"/>
                </button>
            </div>
            <div class="o_bgg_month_grid px-2 pt-2 text-center small fw-bold text-muted text-capitalize">
                <t t-foreach="weekdays" t-as="weekday" t-key="weekday_index">
                    <span t-esc="weekday"/>
                </t>
            </div>
            <div class="o_bgg_month_grid p-2">
                <t t-foreach="cells" t-as="cell" t-key="cell.iso">
                    <button type="button" t-att-class="cell.className" t-att-disabled="cell.disabled"
                            t-att-title="cell.title" t-on-click="() => this.selectDay(cell)" t-esc="cell.day"/>
                </t>
            </div>
            <div class="d-flex flex-wrap gap-3 px-2 pb-2 small text-muted">
                <span><span class="o_bgg_legend border border-primary"/> Heures libres</span>
                <span><span class="o_bgg_legend bg-primary"/> Jour choisi</span>
                <span><span class="o_bgg_legend bg-light border"/> Complet / fermé</span>
            </div>
        </div>
    </t>

    <t t-name="bgg_booking.SlotButtons">
        <div class="o_bgg_slot_grid">
            <t t-foreach="slots" t-as="slot" t-key="slot.id">
                <button type="button" class="btn btn-outline-primary py-2" t-on-click="() => this.choose(slot)">
                    <div class="fw-bold fs-5" t-esc="slot.data.time_label"/>
                    <div class="small text-truncate" t-if="slot.data.commercial_label" t-esc="slot.data.commercial_label"/>
                </button>
            </t>
        </div>
    </t>
</templates>
