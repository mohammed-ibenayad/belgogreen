<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Main Report Template -->
        <template id="report_pv_simulation_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page pv_simulation_report">
                            <!-- Page 1: Cover Page -->
                            <t t-call="pv_simulation_mod_o19.report_pv_simulation_page_cover"/>

                            <!-- Page 2: Installation Location & Production -->
                            <div class="page">
                                <t t-call="pv_simulation_mod_o19.report_pv_simulation_page_location"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- Page 1: Cover Page -->
        <template id="report_pv_simulation_page_cover">
            <div class="pv_cover_page" style="page-break-after: always;">
                <div style="text-align: right; margin-bottom: 50px;">
                    <img t-if="o.company_id.pv_report_logo"
                         t-att-src="'data:image/png;base64,%s' % o.company_id.pv_report_logo.decode()"
                         style="max-height: 80px;"/>
                    <img t-elif="o.company_id.logo"
                         t-att-src="'data:image/png;base64,%s' % o.company_id.logo.decode()"
                         style="max-height: 80px;"/>
                </div>

                <!-- Cover Photo (if provided) -->
                <div t-if="o.cover_photo" style="text-align: center; margin-top: 30px;">
                    <img t-att-src="'data:image/png;base64,%s' % o.cover_photo.decode()"
                         style="max-width: 600px; max-height: 300px; border-radius: 10px;"/>
                </div>

                <div style="text-align: center; margin-top: 150px;">
                    <h1 style="color: #8BC34A; font-size: 48px; font-weight: bold; margin-bottom: 20px;">
                        <t t-esc="o.cover_title or 'VOTRE INSTALLATION PHOTOVOLTAÏQUE'"/>
                    </h1>
                    <p style="font-size: 20px; font-style: italic; color: #666;">
                        <t t-if="o.company_id.pv_report_tagline">
                            <t t-esc="o.company_id.pv_report_tagline"/>
                        </t>
                        <t t-else="">
                            Save your planet. Save your wallet.
                        </t>
                    </p>
                </div>

                <!-- Customer Information -->
                <div style="margin-top: 80px; padding: 20px; background-color: #f9f9f9; border-left: 4px solid #8BC34A;">
                    <h3 style="color: #8BC34A; margin: 0 0 15px 0;">CLIENT</h3>
                    <p style="margin: 5px 0;" t-if="o.sale_order_id.partner_id">
                        <strong style="font-size: 16px;"><t t-esc="o.sale_order_id.partner_id.name"/></strong>
                    </p>
                    <p style="margin: 5px 0;" t-if="o.sale_order_id.partner_id.phone">
                        Tél: <t t-esc="o.sale_order_id.partner_id.phone"/>
                    </p>
                    <p style="margin: 5px 0;" t-if="o.sale_order_id.partner_id.email">
                        Email: <t t-esc="o.sale_order_id.partner_id.email"/>
                    </p>
                    <p style="margin: 5px 0;" t-if="o.installation_address">
                        Adresse: <t t-esc="o.installation_address"/>
                    </p>
                </div>

                <div style="position: absolute; bottom: 50px; width: 100%; text-align: center;">
                    <p style="margin: 5px 0;">
                        <strong><t t-esc="o.company_id.name"/></strong>
                    </p>
                    <p style="margin: 5px 0;">
                        <t t-esc="o.company_id.street"/> -
                        <t t-esc="o.company_id.zip"/>
                        <t t-esc="o.company_id.city"/>
                    </p>
                    <!-- Salesperson name and phone -->
                    <p style="margin: 5px 0;">
                        <t t-if="o.sale_order_id.user_id">
                            <t t-esc="o.sale_order_id.user_id.name"/> |
                            Tél: <t t-esc="o.sale_order_id.user_id.phone or o.company_id.phone"/>
                        </t>
                        <t t-else="">
                            <t t-esc="o.company_id.phone"/>
                        </t>
                    </p>
                    <p style="margin: 5px 0;" t-if="o.company_id.vat">
                        TVA: <t t-esc="o.company_id.vat"/>
                    </p>
                </div>
            </div>
        </template>

        <!-- Page 2: Installation Location & Production -->
        <template id="report_pv_simulation_page_location">
            <h2 style="color: #8BC34A; border-bottom: 3px solid #8BC34A; padding-bottom: 10px;">
                <t t-esc="o.section_title_location or 'LOCALISATION DE L\'INSTALLATION'"/>
            </h2>

            <div style="margin: 30px 0;">
                <p><strong>Adresse:</strong> <t t-esc="o.installation_address"/></p>
                <p t-if="o.roof_surface_m2">
                    <strong>Surface de toiture:</strong> <t t-esc="o.roof_surface_m2"/> m²
                </p>

                <div t-if="o.location_image" style="margin-top: 20px; text-align: center;">
                    <img t-att-src="'data:image/png;base64,%s' % o.location_image.decode()"
                         style="max-width: 400px; max-height: 250px; border: 1px solid #ddd;"/>
                </div>
            </div>

            <h2 style="color: #8BC34A; border-bottom: 3px solid #8BC34A; padding-bottom: 10px; margin-top: 50px;">
                <t t-esc="o.section_title_production or 'PRODUCTION MOYENNE JOURNALIÈRE'"/>
            </h2>

            <div style="margin: 30px 0;">
                <div style="background-color: #f5f5f5; padding: 20px; border-radius: 5px;">
                    <table style="width: 100%;">
                        <tr>
                            <td><strong>Puissance installée:</strong></td>
                            <td><t t-esc="'{:,.0f}'.format(o.total_pv_power_wc)"/> Wc</td>
                        </tr>
                        <tr t-if="o.orientation_deg">
                            <td><strong>Orientation:</strong></td>
                            <td><t t-esc="'{:.0f}'.format(o.orientation_deg)"/>°</td>
                        </tr>
                        <tr t-if="o.tilt_deg">
                            <td><strong>Inclinaison:</strong></td>
                            <td><t t-esc="'{:.0f}'.format(o.tilt_deg)"/>°</td>
                        </tr>
                        <tr>
                            <td><strong>Production annuelle totale:</strong></td>
                            <td style="color: #8BC34A; font-size: 18px; font-weight: bold;">
                                <t t-esc="'{:,.2f}'.format(o.annual_production_kwh)"/> kWh
                            </td>
                        </tr>
                    </table>
                </div>

                <div t-if="o.chart_monthly_production" style="margin-top: 30px; text-align: center;">
                    <img t-att-src="'data:image/png;base64,%s' % o.chart_monthly_production.decode()"
                         style="max-width: 100%;"/>
                </div>
            </div>
        </template>
    </data>
</odoo>
