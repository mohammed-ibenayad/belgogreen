<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pv_battery_config_form" model="ir.ui.view">
        <field name="name">pv.battery.config.form</field>
        <field name="model">pv.battery.config</field>
        <field name="arch" type="xml">
            <form string="Configuration batterie">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la configuration"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Capacité">
                            <label for="capacity_kwh" string="Capacité nominale"/>
                            <div class="o_row">
                                <field name="capacity_kwh"/>
                                <span>kWh</span>
                            </div>
                            <label for="max_daily_charge_kwh" string="Charge quotidienne max"/>
                            <div class="o_row">
                                <field name="max_daily_charge_kwh"/>
                                <span>kWh/jour</span>
                            </div>
                        </group>
                        <group string="Performance">
                            <field name="usable_ratio" widget="percentage"/>
                            <field name="efficiency" widget="percentage"/>
                        </group>
                    </group>
                    <group>
                        <group string="Coût">
                            <label for="cost_per_kwh" string="Coût d'usure"/>
                            <div class="o_row">
                                <field name="cost_per_kwh"/>
                                <span>/kWh</span>
                            </div>
                        </group>
                        <group>
                        </group>
                    </group>
                    <notebook>
                        <page string="Informations techniques" name="technical_info">
                            <group>
                                <group>
                                    <label for="usable_ratio" string="Ratio utilisable — info"/>
                                    <div class="text-muted">
                                        Pourcentage de la capacité nominale réellement utilisable (typiquement 90-95 %)
                                    </div>
                                </group>
                                <group>
                                    <label for="efficiency" string="Rendement — info"/>
                                    <div class="text-muted">
                                        Rendement aller-retour pour un cycle de charge/décharge
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
