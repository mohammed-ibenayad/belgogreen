<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated form view for PV default images config -->
    <record id="view_company_form_pv_defaults" model="ir.ui.view">
        <field name="name">res.company.form.pv.defaults</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form string="PV Report Defaults">
                <sheet>
                    <group>
                        <group string="Default Cover Photo">
                            <field name="pv_default_cover_photo" widget="image" class="oe_avatar"/>
                            <field name="pv_default_cover_photo_filename" invisible="1"/>
                        </group>
                        <group string="Default System Image">
                            <field name="pv_default_system_image" widget="image" class="oe_avatar"/>
                            <field name="pv_default_system_image_filename" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        <p>These images are used as defaults when creating new PV simulations. They can be overridden per simulation.</p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server action to open current company's PV defaults -->
    <record id="action_pv_report_defaults" model="ir.actions.server">
        <field name="name">Report Defaults</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'res.company',
    'res_id': env.company.id,
    'view_mode': 'form',
    'views': [(env.ref('bgg_pv_simulation.view_company_form_pv_defaults').id, 'form')],
    'target': 'inline',
}
        </field>
    </record>
</odoo>
