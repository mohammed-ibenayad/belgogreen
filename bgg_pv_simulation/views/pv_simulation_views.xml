<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_pv_simulation_list" model="ir.ui.view">
        <field name="name">pv.simulation.list</field>
        <field name="model">pv.simulation</field>
        <field name="arch" type="xml">
            <list string="Simulations PV">
                <field name="name" string="Référence"/>
                <field name="sale_order_id" string="Devis"/>
                <field name="installation_address" string="Adresse"/>
                <field name="total_pv_power_wc" string="Puissance PV (Wc)"/>
                <field name="annual_production_kwh" string="Production annuelle (kWh)"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="report_date" string="Date du rapport"/>
                <field name="create_date" string="Créé le"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_pv_simulation_search" model="ir.ui.view">
        <field name="name">pv.simulation.search</field>
        <field name="model">pv.simulation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="installation_address"/>
            </search>
        </field>
    </record>

    <record id="view_pv_simulation_form" model="ir.ui.view">
        <field name="name">pv.simulation.form</field>
        <field name="model">pv.simulation</field>
        <field name="arch" type="xml">
            <form string="Simulation PV">
                <header>
                    <button name="action_regenerate_simulation"
                            string="Régénérer la simulation"
                            type="object"
                            class="oe_highlight"
                            invisible="not id"/>
                    <button name="action_generate_report"
                            string="Rapport PDF"
                            type="object"
                            class="btn-primary"
                            invisible="not id"
                            help="Générer le rapport PDF professionnel"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="simulation_needs_regeneration" invisible="1"/>
                    <div class="alert alert-warning d-flex align-items-center" role="alert"
                         invisible="not simulation_needs_regeneration">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        <span class="flex-grow-1">
                            <strong>Les données de simulation ont été modifiées.</strong>
                            Veuillez régénérer la simulation pour mettre à jour les résultats et le rapport.
                        </span>
                        <button name="action_regenerate_simulation"
                                string="Régénérer la simulation"
                                type="object"
                                class="btn btn-primary btn-sm ms-3"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Devis">
                            <field name="sale_order_id" readonly="1" string="Devis"/>
                            <field name="report_date" string="Date du rapport"/>
                        </group>
                        <group string="Coordonnées GPS">
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ==================== Système PV ==================== -->
                        <page string="Système PV" name="pv_system">
                            <div class="alert alert-info" role="status">
                                <strong>Données du système :</strong> Les panneaux sont détectés automatiquement à partir des produits du devis
                                appartenant à la catégorie <em>All / Saleable / Panneaux</em>.
                                Les batteries sont détectées via la catégorie <em>All / Saleable / Batteries</em>.
                                La production est calculée via Google Solar API et/ou PVGIS. Le profil de production distribue la production annuelle sur les 12 mois.
                            </div>
                            <group>
                                <group string="Configuration des panneaux">
                                    <field name="number_of_panels" readonly="1" string="Nombre de panneaux"/>
                                    <label for="panel_unit_power_wc" string="Puissance unitaire"/>
                                    <div class="o_row">
                                        <field name="panel_unit_power_wc" readonly="1"/>
                                        <span>Wc</span>
                                    </div>
                                    <label for="total_pv_power_wc" string="Puissance totale"/>
                                    <div class="o_row">
                                        <field name="total_pv_power_wc" readonly="1"/>
                                        <span>Wc</span>
                                    </div>
                                    <label for="orientation_deg" string="Orientation"/>
                                    <div class="o_row">
                                        <field name="orientation_deg"/>
                                        <span>° (0=Sud)</span>
                                    </div>
                                    <label for="tilt_deg" string="Inclinaison"/>
                                    <div class="o_row">
                                        <field name="tilt_deg"/>
                                        <span>°</span>
                                    </div>
                                </group>
                                <group string="Configuration batterie">
                                    <label for="battery_capacity_kwh" string="Capacité utile"/>
                                    <div class="o_row">
                                        <field name="battery_capacity_kwh" readonly="1"/>
                                        <span>kWh</span>
                                    </div>
                                    <label for="battery_efficiency" string="Rendement"/>
                                    <div class="o_row">
                                        <field name="battery_efficiency" readonly="1"/>
                                        <span>%</span>
                                    </div>
                                </group>
                                <group string="Production">
                                    <label for="pvgis_annual_production_kwh" string="Production annuelle (PVGIS)"/>
                                    <div class="o_row">
                                        <field name="pvgis_annual_production_kwh"/>
                                        <span>kWh</span>
                                    </div>

                                    <label for="annual_production_kwh" string="Production annuelle (GSA)"/>
                                    <div class="o_row">
                                        <field name="annual_production_kwh" readonly="1"/>
                                        <span>kWh</span>
                                    </div>
                                    <field name="max_panels_count" readonly="1" string="Panneaux max (GSA)"/>
                                </group>
                            </group>

                            <div class="alert alert-warning mt-3" role="alert">
                                <strong>Comment la production est-elle calculée ?</strong>
                                <p class="mb-1 mt-2">
                                    Deux sources de données solaires sont utilisées pour estimer la production de votre installation :
                                </p>
                                <ul class="mb-2">
                                    <li>
                                        <strong>Google Solar API</strong> : fournit une estimation annuelle de la production,
                                        l'image satellite du toit et le nombre maximal de panneaux installables.
                                        L'API calcule avec des panneaux de 400W par défaut — la production est automatiquement
                                        ajustée selon la puissance réelle de vos panneaux (ex : 425Wc).
                                    </li>
                                    <li>
                                        <strong>PVGIS (Photovoltaic Geographical Information System)</strong> : fournit la
                                        répartition mensuelle de la production sur 12 mois. Les paramètres envoyés sont :
                                        coordonnées GPS, puissance crête (kWc), pertes système de 14%, technologie silicium
                                        cristallin, montage en toiture. L'inclinaison et l'orientation sont envoyées si renseignées,
                                        sinon PVGIS utilise les valeurs optimales pour votre localisation.
                                    </li>
                                </ul>
                                <p class="mb-0">
                                    <strong>Priorité</strong> : les données mensuelles PVGIS sont utilisées pour le rapport.
                                    Google Solar fournit la référence annuelle et l'imagerie satellite.
                                </p>
                            </div>
                        </page>

                        <!-- ==================== Couverture (Page 1) ==================== -->
                        <page string="Couverture (Page 1)" name="page_cover">
                            <div class="alert alert-info" role="status">
                                <strong>Données à saisir :</strong> Photo de couverture et titres affichés sur la première page du rapport.
                            </div>
                            <group>
                                <group string="Photo de couverture">
                                    <field name="cover_photo" widget="image" class="oe_avatar" string="Photo"/>
                                </group>
                                <group string="Titre">
                                    <field name="cover_title" string="Titre (ligne 1)"/>
                                    <field name="cover_subtitle" string="Titre (ligne 2)"/>
                                </group>
                            </group>
                        </page>

                        <!-- ==================== Localisation (Page 2) ==================== -->
                        <page string="Localisation (Page 2)" name="page_localisation">
                            <div class="alert alert-info" role="status">
                                <strong>Données à saisir :</strong> Adresse, coordonnées GPS et image satellite de l'installation.
                                L'adresse est pré-remplie depuis la fiche client du devis.
                            </div>
                            <group>
                                <group string="Emplacement">
                                    <field name="installation_address" string="Adresse d'installation"/>
                                    <field name="roof_surface_m2" string="Surface de toiture (m²)"/>
                                </group>
                                <group string="Image de localisation">
                                    <field name="location_image" widget="image" class="oe_avatar" string="Image satellite"/>
                                </group>
                            </group>
                            <group string="Titre de section">
                                <field name="section_title_location" placeholder="LOCALISATION DE L'INSTALLATION" string="Titre"/>
                            </group>
                        </page>

                        <!-- ==================== Production (Page 3) ==================== -->
                        <page string="Production (Page 3)" name="page_production">
                            <div class="alert alert-info" role="status">
                                <strong>Données à saisir :</strong> Image du système (photo des panneaux, schéma d'implantation).
                                Le graphique de production est généré automatiquement à partir des données PVGIS ou du profil de production.
                            </div>
                            <group>
                                <group string="Image du système">
                                    <field name="system_image" widget="image" class="oe_avatar" string="Image"/>
                                </group>
                                <group string="Configuration">
                                    <field name="production_profile_id" string="Profil de production"/>
                                </group>
                            </group>
                            <group string="Titres de section">
                                <field name="section_title_production" placeholder="PRODUCTION ESTIMÉE" string="Titre production"/>
                                <field name="section_title_system" placeholder="CARACTÉRISTIQUES DU SYSTÈME" string="Titre système"/>
                            </group>
                            <separator string="Aperçu du graphique"/>
                            <field name="chart_monthly_production" widget="image" nolabel="1"
                                   style="max-width: 100%; width: 800px;"/>
                        </page>

                        <!-- ==================== Consommation (Page 4) ==================== -->
                        <page string="Consommation (Page 4)" name="page_consumption">
                            <div class="alert alert-warning" role="status">
                                <strong>Données à saisir :</strong> Saisissez les valeurs par défaut ci-dessous puis cliquez sur
                                « Appliquer à tous les mois ». Vous pouvez ensuite modifier chaque mois individuellement dans le tableau.
                            </div>
                            <group>
                                <group string="Consommation Client">
                                    <label for="default_monthly_consumption_kwh" string="Consommation mensuelle"/>
                                    <div class="o_row">
                                        <field name="default_monthly_consumption_kwh"/>
                                        <span>kWh/mois</span>
                                    </div>
                                    <label for="default_daily_day_consumption_kwh" string="Consommation jour quotidienne"/>
                                    <div class="o_row">
                                        <field name="default_daily_day_consumption_kwh"/>
                                        <span>kWh/jour</span>
                                    </div>
                                    <label for="default_daily_night_consumption_kwh" string="Consommation nuit quotidienne"/>
                                    <div class="o_row">
                                        <field name="default_daily_night_consumption_kwh"/>
                                        <span>kWh/jour</span>
                                    </div>
                                </group>
                                <group string="Actions">
                                    <button name="action_apply_default_consumption"
                                            string="Appliquer à tous les mois"
                                            type="object"
                                            class="btn-primary"
                                            invisible="not id"
                                            confirm="Ceci va écraser les valeurs de consommation pour tous les mois. Continuer ?"/>
                                </group>
                            </group>
                            <group>
                                <group string="Profil tarifaire">
                                    <field name="tariff_profile_id" string="Profil tarifaire"
                                           options="{'no_create': False, 'no_open': False}"/>
                                </group>
                                <group string="Titre bilan financier">
                                    <field name="section_title_financial" placeholder="BILAN FINANCIER MENSUEL" string="Titre"/>
                                </group>
                            </group>
                            <group string="Titres de section">
                                <field name="section_title_consumption" placeholder="DONNÉES DE CONSOMMATION" string="Titre principal"/>
                                <field name="section_title_monthly_data" placeholder="DONNÉES MENSUELLES" string="Sous-titre données mensuelles"/>
                                <field name="section_title_daily_balance" placeholder="BILAN ÉNERGÉTIQUE QUOTIDIEN" string="Sous-titre bilan quotidien"/>
                            </group>
                            <separator string="Résultats mensuels"/>
                            <field name="monthly_result_ids" nolabel="1"/>
                            <div class="alert alert-secondary mt-3" role="status">
                                <strong>Légende des données :</strong>
                                <ul class="mb-0">
                                    <li><strong>Prod. (kWh)</strong> — Production mensuelle : calculée automatiquement (jours du mois × production quotidienne moyenne). Source : PVGIS ou profil de production.</li>
                                    <li><strong>Conso. (kWh)</strong> — Consommation mensuelle : saisie manuelle (estimation ou historique facture client).</li>
                                    <li><strong>Prod. quot. (kWh)</strong> — Production quotidienne moyenne : calculée en divisant la production mensuelle par le nombre de jours du mois.</li>
                                    <li><strong>Conso jour / nuit (kWh)</strong> — Consommation quotidienne jour/nuit : saisie manuelle par mois, ou appliquée depuis les valeurs par défaut ci-dessus.</li>
                                    <li><strong>Charge (kWh)</strong> — Énergie stockée dans la batterie : calculée automatiquement à partir du surplus PV, de la capacité et du rendement de la batterie.</li>
                                    <li><strong>Vente (kWh)</strong> — Surplus revendu au réseau : calculé automatiquement (surplus PV − charge batterie).</li>
                                    <li><strong>Achat (kWh)</strong> — Énergie achetée au réseau : calculé automatiquement (consommation nuit − énergie batterie disponible).</li>
                                    <li><strong>Économies panneaux / batterie</strong> — Calculées automatiquement à partir des tarifs d'achat/vente et de la configuration batterie.</li>
                                </ul>
                            </div>
                        </page>

                        <!-- ==================== Bilan (Page 5) ==================== -->
                        <page string="Bilan (Page 5)" name="page_bilan">
                            <group string="Titre de section">
                                <field name="section_title_bilan" placeholder="BILAN ÉNERGÉTIQUE" string="Titre"/>
                            </group>
                            <div class="alert alert-info" role="status">
                                Le bilan énergétique annuel est calculé automatiquement à partir des résultats mensuels de l'onglet Consommation (Page 4).
                            </div>

                            <!-- Production -->
                            <group string="Production">
                                <group>
                                    <label for="bilan_production_total" string="Production totale"/>
                                    <div class="o_row">
                                        <field name="bilan_production_total" readonly="1"/>
                                        <span>kWh</span>
                                    </div>
                                </group>
                            </group>

                            <!-- Consommation -->
                            <group string="Consommation">
                                <group>
                                    <label for="bilan_conso_day" string="Jour"/>
                                    <div class="o_row">
                                        <field name="bilan_conso_day" readonly="1"/>
                                        <span>kWh</span>
                                    </div>
                                    <label for="bilan_conso_night" string="Nuit"/>
                                    <div class="o_row">
                                        <field name="bilan_conso_night" readonly="1"/>
                                        <span>kWh</span>
                                    </div>
                                </group>
                                <group>
                                    <label for="bilan_conso_total" string="Totale"/>
                                    <div class="o_row">
                                        <field name="bilan_conso_total" readonly="1"/>
                                        <span>kWh</span>
                                    </div>
                                </group>
                            </group>

                            <!-- Auto Consommation -->
                            <group string="Auto Consommation">
                                <group>
                                    <label for="bilan_autocons_day" string="Consommé la journée"/>
                                    <div class="o_row">
                                        <field name="bilan_autocons_day" readonly="1"/>
                                        <span>kWh</span>
                                    </div>
                                    <label for="bilan_battery_charge" string="Stocké dans la batterie"/>
                                    <div class="o_row">
                                        <field name="bilan_battery_charge" readonly="1"/>
                                        <span>kWh</span>
                                    </div>
                                </group>
                                <group>
                                    <label for="bilan_autocons_total" string="Total"/>
                                    <div class="o_row">
                                        <field name="bilan_autocons_total" readonly="1"/>
                                        <span>kWh</span>
                                    </div>
                                </group>
                            </group>

                            <!-- Économies -->
                            <group string="Économies">
                                <group>
                                    <label for="bilan_savings_panels" string="Liées aux panneaux"/>
                                    <div class="o_row">
                                        <field name="bilan_savings_panels" readonly="1"/>
                                        <span>€</span>
                                    </div>
                                    <label for="bilan_savings_battery" string="Liées à la batterie"/>
                                    <div class="o_row">
                                        <field name="bilan_savings_battery" readonly="1"/>
                                        <span>€</span>
                                    </div>
                                    <label for="bilan_savings_resale" string="Liées à la revente"/>
                                    <div class="o_row">
                                        <field name="bilan_savings_resale" readonly="1"/>
                                        <span>€</span>
                                    </div>
                                </group>
                                <group>
                                    <label for="bilan_savings_total" string="Total économies"/>
                                    <div class="o_row">
                                        <field name="bilan_savings_total" readonly="1"/>
                                        <span>€</span>
                                    </div>
                                    <label for="bilan_purchase_total" string="Coût d'achat réseau"/>
                                    <div class="o_row">
                                        <field name="bilan_purchase_total" readonly="1"/>
                                        <span>€</span>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
