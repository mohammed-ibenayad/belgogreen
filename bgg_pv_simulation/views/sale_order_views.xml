<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_pv_button" model="ir.ui.view">
        <field name="name">sale.order.form.pv.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_pv_simulation"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-solar-panel"
                        groups="bgg_pv_simulation.group_pv_user">
                    <field name="pv_simulation_count" widget="statinfo" string="Simulations PV"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
