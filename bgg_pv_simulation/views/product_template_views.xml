<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Product Template Form View -->
    <record id="view_product_template_form_pv_inherit" model="ir.ui.view">
        <field name="name">product.template.form.pv.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Add solar panel fields in the General Information tab -->
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Solar Panel Specifications" invisible="not is_solar_panel">
                    <field name="is_solar_panel" invisible="1"/>
                    <field name="panel_unit_power_wc" invisible="not is_solar_panel"/>
                </group>
                <group string="Battery Specifications" invisible="not is_battery">
                    <field name="is_battery" invisible="1"/>
                    <field name="battery_capacity_kwh" invisible="not is_battery"/>
                    <field name="battery_efficiency_percent" invisible="not is_battery"/>
                </group>
            </xpath>

            <!-- Add checkboxes in Attributes -->
            <xpath expr="//group[@name='group_general']" position="after">
                <group>
                    <field name="is_solar_panel"/>
                    <field name="is_battery"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
