<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pv_consumption_profile_form" model="ir.ui.view">
        <field name="name">pv.consumption.profile.form</field>
        <field name="model">pv.consumption.profile</field>
        <field name="arch" type="xml">
            <form string="Consumption Profile">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Profile Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Annual Consumption">
                            <field name="annual_consumption_kwh"/>
                            <field name="monthly_consumption_kwh" readonly="1"/>
                        </group>
                        <group string="Daily Totals">
                            <field name="daily_total_consumption_kwh" readonly="1"/>
                        </group>
                    </group>
                    <group string="Daily Breakdown">
                        <group>
                            <label for="daily_day_consumption_kwh" string="Day Consumption"/>
                            <div class="o_row">
                                <field name="daily_day_consumption_kwh"/>
                                <span>kWh/day</span>
                            </div>
                        </group>
                        <group>
                            <label for="daily_night_consumption_kwh" string="Night Consumption"/>
                            <div class="o_row">
                                <field name="daily_night_consumption_kwh"/>
                                <span>kWh/night</span>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
