<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pv_simulation_wizard_form" model="ir.ui.view">
        <field name="name">pv.simulation.wizard.form</field>
        <field name="model">pv.simulation.wizard</field>
        <field name="arch" type="xml">
            <form string="Nouvelle Simulation PV">
                <sheet>
                    <div class="oe_title mb-3">
                        <h2>Nouvelle Simulation PV</h2>
                    </div>

                    <group>
                        <group string="Devis">
                            <field name="sale_order_id"/>
                            <field name="partner_id"/>
                            <field name="installation_address"/>
                        </group>
                    </group>

                    <separator string="Coordonnées GPS"/>
                    <group>
                        <group>
                            <field name="latitude" placeholder="ex: 50.8503396"/>
                        </group>
                        <group>
                            <field name="longitude" placeholder="ex: 4.3517103"/>
                        </group>
                    </group>

                    <separator string="Consommation du client"/>
                    <group>
                        <group>
                            <label for="default_monthly_consumption_kwh"/>
                            <div class="o_row">
                                <field name="default_monthly_consumption_kwh"/>
                                <span>kWh/mois</span>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group>
                            <label for="default_daily_day_consumption_kwh"/>
                            <div class="o_row">
                                <field name="default_daily_day_consumption_kwh"/>
                                <span>kWh/jour</span>
                            </div>
                        </group>
                        <group>
                            <label for="default_daily_night_consumption_kwh"/>
                            <div class="o_row">
                                <field name="default_daily_night_consumption_kwh"/>
                                <span>kWh/nuit</span>
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_and_generate"
                            string="Créer et Générer"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_create_simulation"
                            string="Créer"
                            type="object"
                            class="btn-secondary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pv_simulation_wizard" model="ir.actions.act_window">
        <field name="name">Nouvelle Simulation PV</field>
        <field name="res_model">pv.simulation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
