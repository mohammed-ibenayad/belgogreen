<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Google Solar API Configuration -->
        <!-- This parameter stores the API key for Google Solar API -->
        <!-- To configure: Settings > Technical > Parameters > System Parameters -->
        <!-- Set key: google_solar_api_key, value: YOUR_API_KEY -->

        <record id="google_solar_api_key_param" model="ir.config_parameter">
            <field name="key">google_solar_api_key</field>
            <field name="value"></field>
        </record>

        <record id="google_solar_api_enabled_param" model="ir.config_parameter">
            <field name="key">google_solar_api_enabled</field>
            <field name="value">False</field>
        </record>

    </data>
</odoo>
